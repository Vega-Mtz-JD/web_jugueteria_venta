<file path="src/app/sitemap.ts">
import type { MetadataRoute } from "next";
import { listCategories, listProducts } from "@/features/catalog/cached";
import { siteUrl } from "@/lib/site";

export default async function sitemap(): Promise<MetadataRoute.Sitemap> {
  const base = siteUrl();
  const [categories, products] = await Promise.all([listCategories(), listProducts({ orden: "destacados" })]);
  return [
    { url: base, changeFrequency: "weekly", priority: 1 },
    { url: `${base}/catalogo`, changeFrequency: "daily", priority: 0.9 },
    ...categories.map((c) => ({ url: `${base}/catalogo?categoria=${c.slug}`, changeFrequency: "weekly" as const, priority: 0.7 })),
    ...products.map((p) => ({ url: `${base}/producto/${p.slug}`, changeFrequency: "weekly" as const, priority: 0.8 })),
  ];
}
</file>

<file path="src/components/brand/Cube3D.module.css">
.scene {
  perspective: 900px;
}

.cube {
  --size: 130px;
  --half: calc(var(--size) / 2);
  position: relative;
  width: var(--size);
  height: var(--size);
  transform-style: preserve-3d;
  transform: rotateX(-24deg) rotateY(-30deg);
  animation: spin 16s linear infinite;
}

.scene:hover .cube {
  animation-duration: 5s;
}

.face {
  position: absolute;
  inset: 0;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: calc(var(--size) * 0.04);
  padding: calc(var(--size) * 0.045);
  border-radius: calc(var(--size) * 0.11);
  background: var(--color-tinta);
  backface-visibility: hidden;
}

.face i {
  border-radius: calc(var(--size) * 0.045);
  box-shadow:
    inset 0 -3px 0 rgb(0 0 0 / 0.18),
    inset 0 2px 0 rgb(255 255 255 / 0.25);
}

.front { transform: translateZ(var(--half)); }
.back { transform: rotateY(180deg) translateZ(var(--half)); }
.right { transform: rotateY(90deg) translateZ(var(--half)); }
.left { transform: rotateY(-90deg) translateZ(var(--half)); }
.top { transform: rotateX(90deg) translateZ(var(--half)); }
.bottom { transform: rotateX(-90deg) translateZ(var(--half)); }

@keyframes spin {
  from { transform: rotateX(-24deg) rotateY(0deg); }
  to { transform: rotateX(-24deg) rotateY(360deg); }
}
</file>

