<file path="src/features/catalog/filters.ts">
import type { CatalogFilters, CatalogSort, StoreSettings } from "./types";

type SearchParams = Record<string, string | string[] | undefined>;

const SORTS: readonly CatalogSort[] = ["destacados", "precio_asc", "precio_desc", "nuevos"];

function first(value: string | string[] | undefined): string | undefined {
  return Array.isArray(value) ? value[0] : value;
}

function intInRange(value: string | undefined, min: number, max: number): number | undefined {
  if (value === undefined || !/^\d+$/.test(value.trim())) return undefined;
  const n = Number(value);
  return n >= min && n <= max ? n : undefined;
}

/** Convierte los parámetros de la URL en filtros válidos; lo inválido se ignora. */
export function parseCatalogFilters(sp: SearchParams): CatalogFilters {
  const filters: CatalogFilters = { orden: "destacados" };

  const orden = first(sp.orden);
  if (orden && (SORTS as readonly string[]).includes(orden)) filters.orden = orden as CatalogSort;

  const categoria = first(sp.categoria)?.trim();
  if (categoria) filters.categoria = categoria;

  const q = first(sp.q)?.trim();
  if (q) filters.q = q;

  let precioMin = intInRange(first(sp.precio_min), 0, 1_000_000);
  let precioMax = intInRange(first(sp.precio_max), 0, 1_000_000);
  if (precioMin !== undefined && precioMax !== undefined && precioMin > precioMax) {
    [precioMin, precioMax] = [precioMax, precioMin];
  }
  if (precioMin !== undefined) filters.precioMin = precioMin;
  if (precioMax !== undefined) filters.precioMax = precioMax;

  const edad = intInRange(first(sp.edad), 0, 99);
  if (edad !== undefined) filters.edad = edad;

  const jugadores = intInRange(first(sp.jugadores), 1, 20);
  if (jugadores !== undefined) filters.jugadores = jugadores;

  if (first(sp.ofertas) === "1") filters.ofertas = true;

  return filters;
}

/** Arma la URL del catálogo para unos filtros (inversa de parseCatalogFilters). */
export function catalogHref(f: CatalogFilters): string {
  const sp = new URLSearchParams();
  if (f.categoria) sp.set("categoria", f.categoria);
  if (f.q) sp.set("q", f.q);
  if (f.precioMin !== undefined) sp.set("precio_min", String(f.precioMin));
  if (f.precioMax !== undefined) sp.set("precio_max", String(f.precioMax));
  if (f.edad !== undefined) sp.set("edad", String(f.edad));
  if (f.jugadores !== undefined) sp.set("jugadores", String(f.jugadores));
  if (f.ofertas) sp.set("ofertas", "1");
  if (f.orden !== "destacados") sp.set("orden", f.orden);
  const qs = sp.toString();
  return qs ? `/catalogo?${qs}` : "/catalogo";
}

type StoreSettingsRow = {
  store_name: string;
  tagline: string | null;
  whatsapp_phone: string | null;
  address: string | null;
  pickup_hours: string | null;
};

/** Ajustes de la tienda; si aún no existe la fila, valores por defecto para que la web no se caiga. */
export function settingsFromRow(row: StoreSettingsRow | null): StoreSettings {
  return {
    storeName: row?.store_name ?? "Ludiq",
    tagline: row?.tagline ?? null,
    whatsappPhone: row?.whatsapp_phone ?? null,
    address: row?.address ?? null,
    pickupHours: row?.pickup_hours ?? null,
  };
}
</file>

<file path="src/features/catalog/queries.ts">
import { productImageUrl } from "@/lib/images";
import { bsToCents } from "@/lib/money";
import { escapeLike, normalizeSearch } from "@/lib/search";
import { supabaseEnv } from "@/lib/supabase/env";
import { createPublicSupabase } from "@/lib/supabase/public";
import { settingsFromRow } from "./filters";
import type { CatalogFilters, Category, ProductCardData, ProductDetail, StoreSettings } from "./types";

const PRODUCT_COLUMNS =
  "id, slug, name, description, price_cents, compare_at_cents, min_age, min_players, max_players, stock, is_new, created_at, categories!inner(name, slug), product_images(path, alt, sort_order)";

type ProductRow = {
  id: string;
  slug: string;
  name: string;
  description: string | null;
  price_cents: number;
  compare_at_cents: number | null;
  min_age: number | null;
  min_players: number | null;
  max_players: number | null;
  stock: number;
  is_new: boolean;
  categories: { name: string; slug: string };
  product_images: { path: string; alt: string | null; sort_order: number }[];
};

function sortedImages(row: ProductRow) {
  return [...row.product_images].sort((a, b) => a.sort_order - b.sort_order);
}

function toCard(row: ProductRow, supabaseUrl: string): ProductCardData {
  return {
    id: row.id,
    slug: row.slug,
    name: row.name,
    categoryName: row.categories.name,
    priceCents: row.price_cents,
    compareAtCents: row.compare_at_cents,
    minAge: row.min_age,
    minPlayers: row.min_players,
    maxPlayers: row.max_players,
    inStock: row.stock > 0,
    stock: row.stock,
    isNew: row.is_new,
    imageUrl: productImageUrl(sortedImages(row)[0]?.path ?? null, supabaseUrl),
  };
}

export async function listCategories(): Promise<Category[]> {
  const { data, error } = await createPublicSupabase()
    .from("categories")
    .select("id, name, slug")
    .order("sort_order");
  if (error) throw error;
  return data;
}

export async function listProducts(f: CatalogFilters, limit?: number): Promise<ProductCardData[]> {
  let query = createPublicSupabase().from("products").select(PRODUCT_COLUMNS).eq("is_active", true);

  if (f.categoria) query = query.eq("categories.slug", f.categoria);
  if (f.q) {
    // Cada palabra debe aparecer, en cualquier orden: "ajedrez madera" encuentra "Ajedrez de madera".
    for (const word of normalizeSearch(f.q).split(" ").filter(Boolean)) {
      query = query.ilike("search_text", `%${escapeLike(word)}%`);
    }
  }
  if (f.precioMin !== undefined) query = query.gte("price_cents", bsToCents(f.precioMin));
  if (f.precioMax !== undefined) query = query.lte("price_cents", bsToCents(f.precioMax));
  if (f.ofertas) query = query.not("compare_at_cents", "is", null);
  if (f.edad !== undefined) query = query.or(`min_age.is.null,min_age.lte.${f.edad}`);
  if (f.jugadores !== undefined) {
    const n = f.jugadores;
    query = query.or(
      `and(min_players.is.null,max_players.is.null),and(min_players.is.null,max_players.gte.${n}),` +
        `and(min_players.lte.${n},max_players.is.null),and(min_players.lte.${n},max_players.gte.${n})`,
    );
  }

  switch (f.orden) {
    case "precio_asc":
      query = query.order("price_cents", { ascending: true });
      break;
    case "precio_desc":
      query = query.order("price_cents", { ascending: false });
      break;
    case "nuevos":
      query = query.order("created_at", { ascending: false });
      break;
    default:
      query = query.order("is_new", { ascending: false }).order("created_at", { ascending: false });
  }
  query = query.order("name");

  const { data, error } = await query.returns<ProductRow[]>();
  if (error) throw error;

  const { url } = supabaseEnv();
  // Los agotados van al final sin alterar el orden elegido (sort es estable).
  const cards = data.map((row) => toCard(row, url)).sort((a, b) => Number(b.inStock) - Number(a.inStock));
  return limit === undefined ? cards : cards.slice(0, limit);
}

/** Productos activos por id, sin caché (stock y precio al día para el carrito). */
export async function listProductsByIds(ids: string[]): Promise<ProductCardData[]> {
  const { data, error } = await createPublicSupabase()
    .from("products")
    .select(PRODUCT_COLUMNS)
    .eq("is_active", true)
    .in("id", ids)
    .returns<ProductRow[]>();
  if (error) throw error;
  const { url } = supabaseEnv();
  return data.map((row) => toCard(row, url));
}

export async function getProductBySlug(slug: string): Promise<ProductDetail | null> {
  const { data, error } = await createPublicSupabase()
    .from("products")
    .select(PRODUCT_COLUMNS)
    .eq("is_active", true)
    .eq("slug", slug)
    .returns<ProductRow[]>()
    .maybeSingle();
  if (error) throw error;
  if (!data) return null;

  const { url } = supabaseEnv();
  return {
    ...toCard(data, url),
    description: data.description,
    categorySlug: data.categories.slug,
    images: sortedImages(data).map((img) => ({ url: productImageUrl(img.path, url), alt: img.alt ?? data.name })),
  };
}

export async function getStoreSettings(): Promise<StoreSettings> {
  const { data, error } = await createPublicSupabase()
    .from("store_settings")
    .select("store_name, tagline, whatsapp_phone, address, pickup_hours")
    .maybeSingle();
  if (error) throw error;
  return settingsFromRow(data);
}
</file>

<file path="src/features/orders/actions.ts">
"use server";

import { z } from "zod";
import { createServerSupabase } from "@/lib/supabase/server";

export type ActionResult = { ok: true } | { error: string };

export async function submitProofAction(orderId: string, path: string): Promise<ActionResult> {
  if (!z.uuid().safeParse(orderId).success) return { error: "No encontramos ese pedido" };
  const supabase = await createServerSupabase();
  const { error } = await supabase.rpc("submit_payment_proof", { p_order_id: orderId, p_path: path });
  if (error) return { error: error.code === "P0001" ? error.message : "No pudimos enviar la captura. Vuelve a intentarlo." };
  return { ok: true };
}

/** Estado actual del pedido propio (para explicar por qué no se pudo subir la captura). */
export async function orderStatusAction(orderId: string): Promise<string | null> {
  if (!z.uuid().safeParse(orderId).success) return null;
  const supabase = await createServerSupabase();
  const { data } = await supabase.from("orders").select("status").eq("id", orderId).maybeSingle();
  return data?.status ?? null;
}

export async function cancelOrderAction(orderId: string): Promise<ActionResult> {
  if (!z.uuid().safeParse(orderId).success) return { error: "No encontramos ese pedido" };
  const supabase = await createServerSupabase();
  const { error } = await supabase.rpc("cancel_order_by_customer", { p_order_id: orderId });
  if (error) return { error: error.code === "P0001" ? error.message : "No pudimos cancelar el pedido. Vuelve a intentarlo." };
  return { ok: true };
}
