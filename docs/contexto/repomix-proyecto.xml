  const [order, setOrder] = useState<"units" | "revenue">("units");
  const rows = [...top]
    .sort((a, b) => (order === "units" ? b.units - a.units || b.revenueCents - a.revenueCents : b.revenueCents - a.revenueCents || b.units - a.units))
