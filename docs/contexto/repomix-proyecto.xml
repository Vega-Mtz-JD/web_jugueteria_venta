select is((select count(*)::int from jsonb_array_elements(pg_temp.dia('2026-10-10') -> 'rows') r
           where r ->> 'channel' = 'web' and (r ->> 'orderNumber') is not null and r ->> 'orderId' = current_setting('t.o1')),
