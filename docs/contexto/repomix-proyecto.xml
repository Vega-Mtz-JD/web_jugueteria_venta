    }, risk);
    await page.goto("/checkout");
    await page.getByLabel("Celular").fill("71234567");
    await expect(page.getByText(/Ajustamos tu carrito/)).toBeVisible();
    await expect(page.getByTestId("checkout-summary")).not.toContainText("Risk");
  });
});
