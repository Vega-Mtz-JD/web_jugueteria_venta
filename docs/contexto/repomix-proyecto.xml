import { describe, expect, it } from "vitest";
import { cartReducer, type CartLine } from "./cart-store";

const A = "00000000-0000-0000-0000-00000000000a";
const B = "00000000-0000-0000-0000-00000000000b";

describe("cartReducer", () => {
  it("agregar dos veces suma la cantidad", () => {
    let lines: CartLine[] = [];
    lines = cartReducer(lines, { type: "add", productId: A, quantity: 1, maxStock: 5 });
    lines = cartReducer(lines, { type: "add", productId: A, quantity: 2, maxStock: 5 });
    expect(lines).toEqual([{ productId: A, quantity: 3 }]);
  });

  it("no supera el stock ni 20 unidades", () => {
    expect(cartReducer([], { type: "add", productId: A, quantity: 9, maxStock: 2 })).toEqual([{ productId: A, quantity: 2 }]);
    expect(cartReducer([], { type: "add", productId: A, quantity: 50, maxStock: 99 })).toEqual([{ productId: A, quantity: 20 }]);
  });

  it("sin stock no agrega nada", () => {
    expect(cartReducer([], { type: "add", productId: A, quantity: 1, maxStock: 0 })).toEqual([]);
  });

  it("poner cantidad 0 quita la línea", () => {
    expect(cartReducer([{ productId: A, quantity: 2 }], { type: "setQuantity", productId: A, quantity: 0, maxStock: 5 })).toEqual([]);
  });

  it("quitar y vaciar", () => {
    const lines = [{ productId: A, quantity: 1 }, { productId: B, quantity: 1 }];
    expect(cartReducer(lines, { type: "remove", productId: A })).toEqual([{ productId: B, quantity: 1 }]);
    expect(cartReducer(lines, { type: "clear" })).toEqual([]);
  });

  it("reconcile quita agotados o inexistentes y recorta al stock", () => {
    const lines = [{ productId: A, quantity: 2 }, { productId: B, quantity: 5 }, { productId: "otro", quantity: 1 }];
    expect(cartReducer(lines, { type: "reconcile", available: { [A]: 0, [B]: 2 } })).toEqual([{ productId: B, quantity: 2 }]);
  });
});
</file>

<file path="src/features/cart/cart-store.ts">
export type CartLine = { productId: string; quantity: number };

export const MAX_PER_LINE = 20;

export type CartAction =
  | { type: "add"; productId: string; quantity: number; maxStock: number }
  | { type: "setQuantity"; productId: string; quantity: number; maxStock: number }
  | { type: "remove"; productId: string }
  | { type: "clear" }
  | { type: "reconcile"; available: Record<string, number> };

const clamp = (quantity: number, maxStock: number) => Math.max(0, Math.min(Math.floor(quantity), maxStock, MAX_PER_LINE));

export function cartReducer(lines: CartLine[], action: CartAction): CartLine[] {
  switch (action.type) {
    case "add": {
      const current = lines.find((l) => l.productId === action.productId)?.quantity ?? 0;
      return cartReducer(lines, { ...action, type: "setQuantity", quantity: current + action.quantity });
    }
    case "setQuantity": {
      const quantity = clamp(action.quantity, action.maxStock);
      const rest = lines.filter((l) => l.productId !== action.productId);
      if (quantity === 0) return rest;
      const exists = lines.some((l) => l.productId === action.productId);
      return exists
        ? lines.map((l) => (l.productId === action.productId ? { ...l, quantity } : l))
        : [...lines, { productId: action.productId, quantity }];
    }
    case "remove":
      return lines.filter((l) => l.productId !== action.productId);
    case "clear":
      return [];
    case "reconcile":
      return lines
        .map((l) => ({ ...l, quantity: clamp(l.quantity, action.available[l.productId] ?? 0) }))
        .filter((l) => l.quantity > 0);
  }
}

// --- Almacén en localStorage (sobrevive al login y a cerrar la pestaña) ---------------
const KEY = "ludiq:carrito:v1";
const listeners = new Set<() => void>();
let memory: CartLine[] = [];
let cachedRaw: string | null | undefined;
let cachedLines: CartLine[] = [];
const EMPTY: CartLine[] = [];

function readRaw(): string | null {
  try {
    return window.localStorage.getItem(KEY);
  } catch {
    return null;
  }
}

function parse(raw: string | null): CartLine[] {
  if (!raw) return memory;
  try {
    const value = JSON.parse(raw);
    return Array.isArray(value)
      ? value.filter((l) => typeof l?.productId === "string" && Number.isInteger(l?.quantity) && l.quantity > 0)
      : [];
  } catch {
    return [];
  }
}

export function getCartSnapshot(): CartLine[] {
  const raw = readRaw();
  if (raw !== cachedRaw) {
    cachedRaw = raw;
    cachedLines = parse(raw);
  }
  return raw === null ? memory : cachedLines;
}

export function getServerCartSnapshot(): CartLine[] {
  return EMPTY;
}

export function dispatchCart(action: CartAction): void {
  const next = cartReducer(getCartSnapshot(), action);
  memory = next;
  try {
    window.localStorage.setItem(KEY, JSON.stringify(next));
  } catch {
    // Sin localStorage (modo privado estricto): el carrito vive en memoria.
  }
  listeners.forEach((l) => l());
}

export function subscribeCart(listener: () => void): () => void {
  listeners.add(listener);
  const onStorage = (e: StorageEvent) => e.key === KEY && listener();
  window.addEventListener("storage", onStorage);
  return () => {
    listeners.delete(listener);
    window.removeEventListener("storage", onStorage);
  };
}
</file>

