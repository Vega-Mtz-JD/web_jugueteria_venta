<file path="scripts/backup-storage.mjs">
// Descarga todos los archivos de Supabase Storage a una carpeta (respaldo semanal en GitHub Actions).
// Uso: SUPABASE_URL=… SUPABASE_SERVICE_ROLE_KEY=… node scripts/backup-storage.mjs <carpeta>
import { mkdir, writeFile } from "node:fs/promises";
import path from "node:path";
import { createClient } from "@supabase/supabase-js";

const BUCKETS = ["payment-proofs", "shipping-proofs", "product-images", "store-assets"];
const PAGE = 1000;

const [outDir] = process.argv.slice(2);
const { SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY } = process.env;
if (!outDir || !SUPABASE_URL || !SUPABASE_SERVICE_ROLE_KEY) {
  console.error("Uso: SUPABASE_URL=… SUPABASE_SERVICE_ROLE_KEY=… node scripts/backup-storage.mjs <carpeta>");
  process.exit(1);
}
const supabase = createClient(SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, { auth: { persistSession: false } });

/** Rutas de todos los archivos de un bucket (las carpetas vienen con id null y se recorren). */
async function listAll(bucket, prefix = "") {
  const paths = [];
  for (let offset = 0; ; offset += PAGE) {
    const { data, error } = await supabase.storage.from(bucket).list(prefix, { limit: PAGE, offset, sortBy: { column: "name", order: "asc" } });
    if (error) throw new Error(`${bucket}/${prefix}: ${error.message}`);
    for (const item of data) {
      const full = prefix ? `${prefix}/${item.name}` : item.name;
      if (item.id === null) paths.push(...(await listAll(bucket, full)));
      else paths.push(full);
    }
    if (data.length < PAGE) return paths;
  }
}

let total = 0;
for (const bucket of BUCKETS) {
  for (const file of await listAll(bucket)) {
    const { data, error } = await supabase.storage.from(bucket).download(file);
    if (error) throw new Error(`${bucket}/${file}: ${error.message}`);
    const target = path.join(outDir, bucket, file);
    await mkdir(path.dirname(target), { recursive: true });
    await writeFile(target, Buffer.from(await data.arrayBuffer()));
    total++;
  }
}
console.log(`${total} archivos`);
</file>

<file path="scripts/panel-icons.mjs">
// Genera los íconos del panel instalable (public/icons/panel-*.png) desde el cubo del logo.
// Uso: node scripts/panel-icons.mjs  (los PNG quedan versionados; correrlo solo si cambia el diseño)
import sharp from "sharp";

const COLORS = ["#c0392b", "#f3e6c8", "#3f8a63", "#d9b23a", "#c0392b", "#2f5d8a", "#d9822b", "#3f8a63", "#f3e6c8"];

// Cubo centrado dentro de la zona segura de los íconos "maskable" (80 % central).
function svg(size) {
  const cube = size * 0.5;
  const gap = cube * 0.035;
  const pad = cube * 0.05;
  const cell = (cube - pad * 2 - gap * 2) / 3;
  const x0 = (size - cube) / 2;
  const stickers = COLORS.map((c, i) => {
    const x = x0 + pad + (i % 3) * (cell + gap);
    const y = x0 + pad + Math.floor(i / 3) * (cell + gap);
    return `<rect x="${x}" y="${y}" width="${cell}" height="${cell}" rx="${cell * 0.12}" fill="${c}"/>`;
  }).join("");
  return `<svg xmlns="http://www.w3.org/2000/svg" width="${size}" height="${size}">
    <rect width="${size}" height="${size}" fill="#f6efe3"/>
    <rect x="${x0}" y="${x0}" width="${cube}" height="${cube}" rx="${cube * 0.1}" fill="#2b2118"/>
    ${stickers}
  </svg>`;
}

for (const size of [192, 512]) {
  await sharp(Buffer.from(svg(size))).png().toFile(`public/icons/panel-${size}.png`);
  console.log(`public/icons/panel-${size}.png`);
}
</file>

