        </Button>
      </div>
    );
  }

  return (
    <div className="grid gap-8 md:grid-cols-[1fr_20rem]">
      <div>
        {adjusted.length > 0 && (
          <p role="status" className="mb-4 rounded-xl bg-mostaza/15 px-4 py-3 text-sm font-medium">
