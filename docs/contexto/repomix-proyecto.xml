"use client";

import Link from "next/link";
import { useState } from "react";
import { formatBs } from "@/lib/money";
import { cn } from "@/lib/utils";
import type { TopProduct } from "./queries";

const ORDERS = [
  { value: "units", label: "Unidades" },
  { value: "revenue", label: "Ingresos" },
