}

@layer base {
  * {
    @apply border-border outline-ring/50;
  }
  html {
    @apply font-sans;
    -webkit-text-size-adjust: 100%;
    /* La cabecera es fija: al saltar a un ancla o enfocar, que no tape el contenido. */
