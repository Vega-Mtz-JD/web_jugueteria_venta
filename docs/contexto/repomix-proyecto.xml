<file path="src/features/admin/products/ManualSaleDialog.tsx">
"use client";

import { useRouter } from "next/navigation";
import { useState, useTransition } from "react";
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
import { Input } from "@/components/ui/input";
import { callAction } from "../call-action";
import { recordManualSaleAction } from "../product-actions";
import { bsTextToCents, centsToBsText } from "../product-schema";
import { cn } from "@/lib/utils";

const field = "grid gap-1.5 text-sm font-semibold";

/** "Vendí": registra una venta en la tienda o por WhatsApp y descuenta el stock. */
export function ManualSaleDialog({
  product,
  open,
  onOpenChange,
}: {
  product: { id: string; name: string; priceCents: number };
  open: boolean;
  onOpenChange: (open: boolean) => void;
}) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  const [channel, setChannel] = useState<"tienda" | "whatsapp">("tienda");
  // Un id por venta: si se pierde la respuesta y se vuelve a tocar, la base devuelve la misma venta.
  const [requestId, setRequestId] = useState(() => crypto.randomUUID());

  function submit(form: FormData) {
    const unitPriceCents = bsTextToCents(String(form.get("price") ?? ""));
    const quantity = Number(form.get("quantity"));
    if (unitPriceCents === null) return setError("Escribe el precio de venta");
    if (!Number.isInteger(quantity) || quantity < 1 || quantity > 100) return setError("La cantidad debe ser entre 1 y 100");
    startTransition(async () => {
      const result = await callAction(() =>
        recordManualSaleAction({
        productId: product.id,
        quantity,
        channel,
        unitPriceCents,
        note: String(form.get("note") ?? ""),
        requestId,
        }),
      );
      if ("error" in result) return setError(result.error);
      setError(null);
      setRequestId(crypto.randomUUID());
      onOpenChange(false);
      router.refresh();
    });
  }

  return (
    <Dialog
      open={open}
      onOpenChange={(o) => {
        if (!o) setError(null);
        if (!o) setRequestId(crypto.randomUUID());
        onOpenChange(o);
      }}
    >
      <DialogContent>
        <DialogTitle>Vendí</DialogTitle>
        <DialogDescription>{product.name}</DialogDescription>
        <form
          className="grid gap-4"
          onSubmit={(e) => {
            e.preventDefault();
            submit(new FormData(e.currentTarget));
          }}
        >
          <label className={field}>
            Cantidad
            <Input name="quantity" type="number" inputMode="numeric" min={1} max={100} defaultValue={1} className="h-11 text-base font-normal" />
          </label>
          <fieldset className="grid gap-1.5">
            <legend className="mb-1.5 text-sm font-semibold">Dónde se vendió</legend>
            <div className="grid grid-cols-2 gap-2">
              {(["tienda", "whatsapp"] as const).map((c) => (
                <label
                  key={c}
                  className={cn(
                    "flex min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 font-semibold",
                    channel === c ? "border-verde bg-verde/10 text-verde" : "border-input",
                  )}
                >
                  <input type="radio" name="channel" value={c} checked={channel === c} onChange={() => setChannel(c)} className="sr-only" />
                  {c === "tienda" ? "Tienda" : "WhatsApp"}
                </label>
              ))}
            </div>
          </fieldset>
          <label className={field}>
            Precio unitario (Bs)
            <Input name="price" inputMode="decimal" defaultValue={centsToBsText(product.priceCents)} className="h-11 text-base font-normal" />
          </label>
          <label className={field}>
            Nota (opcional)
            <Input name="note" maxLength={200} className="h-11 text-base font-normal" />
          </label>
          {error && (
            <p role="alert" className="text-sm font-medium text-rojo">
              {error}
            </p>
          )}
          <Button type="submit" size="lg" disabled={pending}>
            {pending ? "Guardando…" : "Registrar venta"}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}
</file>

<file path="src/features/admin/products/PhotoManager.tsx">
"use client";

import { CameraIcon, ImagesIcon, StarIcon, Trash2Icon } from "lucide-react";
import Image from "next/image";
import { useRouter } from "next/navigation";
import { useState, useTransition } from "react";
import { Button } from "@/components/ui/button";
import { compressProductPhoto, extensionFor, validateImageFile } from "@/lib/images-compress";
import { createBrowserSupabase } from "@/lib/supabase/client";
import { callAction, NETWORK_ERROR, uploadErrorMessage } from "../call-action";
import { addProductPhotoAction, makeMainPhotoAction, removeProductPhotoAction } from "../product-actions";

const MAX_PHOTOS = 5;
const pickerClass =
  "inline-flex h-11 cursor-pointer items-center gap-2 rounded-lg border border-madera px-4 text-[0.95rem] font-semibold text-madera hover:bg-madera/10 has-[input:focus-visible]:ring-3 has-[input:focus-visible]:ring-ring/50";

/** Fotos del producto: hasta 5, desde la cámara o la galería; la primera es la principal. */
export function PhotoManager({ productId, productName, images }: { productId: string; productName: string; images: { id: string; url: string }[] }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [status, setStatus] = useState<string | null>(null);
  const [error, setError] = useState<string | null>(null);
  const full = images.length >= MAX_PHOTOS;

  async function upload(files: File[]) {
    setError(null);
    const room = MAX_PHOTOS - images.length;
    if (files.length > room) {
      setError(`Cada producto puede tener hasta ${MAX_PHOTOS} fotos`);
      files = files.slice(0, room);
    }
    for (const file of files) {
      const problem = validateImageFile(file);
      if (problem) {
        setError(problem);
        continue;
      }
      try {
        setStatus("Subiendo foto…");
        const photo = await compressProductPhoto(file);
        const path = `${productId}/${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${extensionFor(photo.type)}`;
        const { error: storageError } = await createBrowserSupabase()
          .storage.from("product-images")
          .upload(path, photo, { contentType: photo.type, upsert: false });
        if (storageError) throw new Error(NETWORK_ERROR);
        const result = await callAction(() => addProductPhotoAction(productId, path));
        if ("error" in result) throw new Error(result.error);
      } catch (e) {
        setError(uploadErrorMessage(e));
      }
    }
    setStatus(null);
    router.refresh();
  }

  function act(action: () => Promise<{ ok: true } | { error: string }>) {
    startTransition(async () => {
      const result = await callAction(action);
      if ("error" in result) setError(result.error);
      else {
        setError(null);
        router.refresh();
      }
    });
  }

  const onFiles = (e: React.ChangeEvent<HTMLInputElement>) => {
    const files = Array.from(e.target.files ?? []);
    e.target.value = "";
    if (files.length) void upload(files);
  };

  return (
    <div className="grid gap-4">
      {images.length > 0 ? (
        <ul className="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-5">
          {images.map((img, i) => (
            <li key={img.id} className="grid gap-2 rounded-2xl bg-papel p-2">
              <div className="relative aspect-square overflow-hidden rounded-xl bg-crema-2">
                <Image src={img.url} alt={`Foto ${i + 1}`} fill sizes="200px" unoptimized={img.url.endsWith(".svg")} className="object-contain" />
                {i === 0 && (
                  <span className="absolute left-2 top-2 rounded-full bg-verde px-2 py-0.5 text-xs font-bold text-crema">Principal</span>
                )}
              </div>
              <div className="flex flex-wrap gap-1">
                {i > 0 && (
                  <Button variant="ghost" size="sm" className="h-10" disabled={pending} onClick={() => act(() => makeMainPhotoAction(img.id))}>
                    <StarIcon aria-hidden />
                    Hacer principal
                  </Button>
                )}
                <Button
                  variant="ghost"
                  size="sm"
                  className="h-10 text-rojo hover:bg-rojo/10"
                  aria-label={`Quitar foto ${i + 1}`}
                  disabled={pending}
                  onClick={() => act(() => removeProductPhotoAction(img.id))}
                >
                  <Trash2Icon aria-hidden />
                  Quitar
                </Button>
              </div>
            </li>
          ))}
        </ul>
      ) : (
        <p className="text-muted-foreground">«{productName}» todavía no tiene fotos. En la tienda se verá una imagen de relleno.</p>
      )}

      {!full && (
        <div className="flex flex-wrap gap-2">
          <label className={pickerClass}>
            <CameraIcon aria-hidden className="size-5" />
            Tomar foto
            <input type="file" accept="image/*" capture="environment" className="sr-only" onChange={onFiles} disabled={status !== null} />
          </label>
          <label className={pickerClass}>
            <ImagesIcon aria-hidden className="size-5" />
            Elegir de la galería
            <input type="file" accept="image/*" multiple className="sr-only" onChange={onFiles} disabled={status !== null} />
          </label>
        </div>
      )}
      <p className="text-sm text-muted-foreground" aria-live="polite">
        {status ?? `${images.length} de ${MAX_PHOTOS} fotos`}
      </p>
      {error && (
        <p role="alert" className="text-sm font-medium text-rojo">
          {error}
        </p>
      )}
    </div>
  );
}
</file>

<file path="src/features/admin/products/ProductForm.tsx">
"use client";

import { useRouter } from "next/navigation";
import { useState, useTransition } from "react";
import { Button } from "@/components/ui/button";
import { Input } from "@/components/ui/input";
import { cn } from "@/lib/utils";
import { callAction } from "../call-action";
import { saveProductAction } from "../product-actions";
import { centsToBsText, type ProductInput } from "../product-schema";
import type { AdminProductDetail } from "../queries";

const field = "grid gap-1.5 text-sm font-semibold";
const control = "h-11 text-base font-normal";

function Field({
  label,
  name,
  error,
  hint,
  className,
  ...props
}: { label: string; name: string; error?: string; hint?: string } & React.ComponentProps<typeof Input>) {
  return (
    <label className={cn(field, className)}>
      {label}
      <Input name={name} aria-invalid={error ? true : undefined} className={control} {...props} />
      {hint && !error && <span className="text-xs font-normal text-muted-foreground">{hint}</span>}
      {error && <span className="text-sm font-medium text-rojo">{error}</span>}
    </label>
  );
}

/** Crear o editar un producto. Al crear se va a su pantalla para agregar fotos. */
export function ProductForm({ product, categories }: { product?: AdminProductDetail; categories: { id: string; name: string }[] }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [errors, setErrors] = useState<Record<string, string>>({});
  const [message, setMessage] = useState<{ ok: boolean; text: string } | null>(null);
  const editing = Boolean(product);
  // "Borrar" puede ocultar el producto desde fuera del formulario: seguir el valor de la base.
  const [active, setActive] = useState(product?.isActive ?? true);
  const [seenActive, setSeenActive] = useState(product?.isActive);
  if (product && product.isActive !== seenActive) {
    setSeenActive(product.isActive);
    setActive(product.isActive);
  }

  function submit(form: FormData) {
    const text = (k: string) => String(form.get(k) ?? "");
    const input: ProductInput = {
      name: text("name"),
      categoryId: text("categoryId"),
      priceBs: text("priceBs"),
      compareAtBs: text("compareAtBs"),
      minAge: text("minAge"),
      minPlayers: text("minPlayers"),
      maxPlayers: text("maxPlayers"),
      stock: editing ? undefined : text("stock"),
      description: text("description"),
      isNew: form.get("isNew") === "on",
      isActive: form.get("isActive") === "on",
    };
    startTransition(async () => {
      const result = await callAction(() => saveProductAction(product?.id ?? null, input));
      if ("error" in result) {
        setErrors("fieldErrors" in result ? result.fieldErrors : {});
        setMessage({ ok: false, text: result.error });
        return;
      }
      setErrors({});
      if (!editing) {
        router.push(`/panel/productos/${result.id}?nuevo=1`);
        return;
      }
      setMessage({ ok: true, text: "Cambios guardados" });
      router.refresh();
    });
  }

  return (
    <form
      className="grid gap-4"
      noValidate
      onSubmit={(e) => {
        e.preventDefault();
        submit(new FormData(e.currentTarget));
      }}
    >
      <Field label="Nombre" name="name" defaultValue={product?.name} maxLength={120} error={errors.name} />
      <div className={field}>
        <label htmlFor="product-category">Categoría</label>
        <select
          id="product-category"
          name="categoryId"
          defaultValue={product?.categoryId ?? ""}
          aria-invalid={errors.categoryId ? true : undefined}
          className="h-11 rounded-lg border border-input bg-background px-3 text-base font-normal"
        >
          <option value="" disabled>
            Elige una categoría
          </option>
          {categories.map((c) => (
            <option key={c.id} value={c.id}>
              {c.name}
            </option>
          ))}
        </select>
        {errors.categoryId && <span className="text-sm font-medium text-rojo">{errors.categoryId}</span>}
      </div>
      <div className="grid grid-cols-2 gap-3">
        <Field label="Precio (Bs)" name="priceBs" inputMode="decimal" defaultValue={centsToBsText(product?.priceCents ?? null)} error={errors.priceBs} />
        <Field
          label="Precio anterior (Bs)"
          name="compareAtBs"
          inputMode="decimal"
          defaultValue={centsToBsText(product?.compareAtCents ?? null)}
          hint="Opcional: marca la oferta"
          error={errors.compareAtBs}
        />
      </div>
      <div className="grid grid-cols-3 gap-3">
        <Field label="Edad mínima" name="minAge" type="number" inputMode="numeric" defaultValue={product?.minAge ?? ""} error={errors.minAge} />
        <Field label="Jugadores mínimo" name="minPlayers" type="number" inputMode="numeric" defaultValue={product?.minPlayers ?? ""} error={errors.minPlayers} />
        <Field label="Jugadores máximo" name="maxPlayers" type="number" inputMode="numeric" defaultValue={product?.maxPlayers ?? ""} error={errors.maxPlayers} />
      </div>
      {!editing && (
        <Field
          label="Stock inicial"
          name="stock"
          type="number"
          inputMode="numeric"
          defaultValue={0}
          hint="Después se corrige con «Contar estante»"
          error={errors.stock}
          className="max-w-48"
        />
      )}
      <label className={field}>
        Descripción
        <textarea
          name="description"
          defaultValue={product?.description ?? ""}
          maxLength={2000}
          rows={5}
          className="rounded-lg border border-input bg-background px-3 py-2 text-base font-normal outline-none focus-visible:ring-3 focus-visible:ring-ring/50"
        />
        {errors.description && <span className="text-sm font-medium text-rojo">{errors.description}</span>}
      </label>
      <div className="flex flex-wrap gap-x-6 gap-y-2">
        <label className="flex min-h-11 items-center gap-2 font-semibold">
          <input type="checkbox" name="isActive" checked={active} onChange={(e) => setActive(e.target.checked)} className="size-5 accent-verde" />
          Visible en la tienda
        </label>
        <label className="flex min-h-11 items-center gap-2 font-semibold">
          <input type="checkbox" name="isNew" defaultChecked={product?.isNew ?? false} className="size-5 accent-verde" />
          Nuevo
        </label>
      </div>
      {message && (
        <p role={message.ok ? "status" : "alert"} className={cn("text-sm font-medium", message.ok ? "text-verde" : "text-rojo")}>
          {message.text}
        </p>
      )}
      <Button type="submit" size="lg" disabled={pending} className="justify-self-start">
        {pending ? "Guardando…" : editing ? "Guardar cambios" : "Crear producto"}
      </Button>
    </form>
  );
}
</file>

