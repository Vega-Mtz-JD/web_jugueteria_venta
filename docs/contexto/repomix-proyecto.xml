<file path="src/features/admin/dashboard/ProfitBars.tsx">
import Link from "next/link";
import { formatBs } from "@/lib/money";
import { cn } from "@/lib/utils";
import { barAmount, barScale } from "./bars";
import { barLabel } from "./period";
import type { Bar } from "./queries";
import { salesHref } from "./sales-filter";

/** Barras de ganancia hechas a mano: cada una lleva a la lista de ventas de su día, semana o mes. */
export function ProfitBars({ bars }: { bars: Bar[] }) {
  const scale = barScale(bars.map((b) => b.profitCents));
  const hasNegative = scale.some((s) => s.negative);
  return (
    <ol aria-label="Ganancia por período" className="mt-4 flex gap-1 sm:gap-2">
      {bars.map((b, i) => {
        const s = scale[i];
        const current = i === bars.length - 1;
        const label = barLabel(b.kind, b.from, b.idx);
        return (
          <li key={b.idx} className="min-w-0 flex-1">
            <Link
              href={salesHref({ from: b.from, to: b.to })}
              aria-label={`${label}: ${formatBs(b.profitCents)} de ganancia${b.withoutCostCents > 0 ? ` y ${formatBs(b.withoutCostCents)} sin costo anotado` : ""}`}
              className="group flex flex-col items-stretch rounded-lg px-0.5 pt-1 hover:bg-crema-2"
            >
              <span aria-hidden className="text-center text-[11px] leading-tight font-semibold tabular-nums text-tinta-suave break-words sm:text-xs">
                {barAmount(b.profitCents)}
              </span>
              {/* Ventas sin costo anotado: no entran en la ganancia, pero hubo ventas. */}
              <span aria-hidden className="h-3 text-center text-[10px] leading-3 font-bold text-madera">{b.withoutCostCents > 0 ? "+?" : ""}</span>
              <span aria-hidden className="flex h-28 items-end">
                {!s.negative && (
                  <span
                    className={cn("w-full rounded-t-md", current ? "bg-verde" : "bg-verde/35 group-hover:bg-verde/55")}
                    style={{ height: `${Math.max(s.pct, b.profitCents > 0 ? 2 : 0)}%` }}
                  />
                )}
              </span>
              {hasNegative && (
                <span aria-hidden className="flex h-8 items-start border-t border-tinta-suave/30">
                  {s.negative && <span className="w-full rounded-b-md bg-rojo/70" style={{ height: `${Math.max(s.pct, 4)}%` }} />}
                </span>
              )}
              <span aria-hidden className={cn("mt-1 text-center text-[11px] leading-tight break-words sm:text-xs", current ? "font-bold text-tinta" : "text-muted-foreground")}>
                {label}
              </span>
            </Link>
          </li>
        );
      })}
    </ol>
  );
}
</file>

<file path="src/features/admin/dashboard/ProfitHero.tsx">
import Link from "next/link";
import { formatBs } from "@/lib/money";
import { cn } from "@/lib/utils";
import { compareLine } from "./compare";
import { previousLabel, profitTitle, type Period } from "./period";
import { ProfitBars } from "./ProfitBars";
import type { DashboardSales } from "./queries";
import { CHANNELS, salesHref } from "./sales-filter";

const plural = (n: number, one: string, many: string) => (n === 1 ? `1 ${one}` : `${n} ${many}`);
const TONE = { up: "text-verde", down: "text-rojo", same: "text-tinta-suave", neutral: "text-muted-foreground" } as const;
const link = "font-semibold text-verde underline-offset-4 hover:underline";

/** Arriba de la portada: cuánto ganó, comparado con el período anterior, con sus barras. */
export function ProfitHero({ data, period }: { data: DashboardSales; period: Period }) {
  const cur = data.current;
  const cmp = compareLine(cur, data.previous, previousLabel(period, data.range));
  return (
    <section aria-label="Ganancia" className="rounded-3xl border border-[#eadcc4] bg-papel p-4 sm:p-6">
      <Link href={salesHref({ period })} className="group block">
        <span className="block font-semibold text-tinta-suave">{profitTitle(period, data.range)}</span>
        <span className={cn("block font-serif text-5xl font-extrabold tabular-nums leading-tight group-hover:underline", cur.profitCents < 0 && "text-rojo")}>
          {formatBs(cur.profitCents)}
        </span>
      </Link>
      <p className={cn("mt-1 font-semibold", TONE[cmp.tone])}>{cmp.text}</p>

      <ProfitBars bars={data.bars} />

      <p className="mt-4">
        <Link href={salesHref({ period })} className={link}>
          Vendiste {formatBs(cur.salesCents)} ({plural(cur.count, "venta", "ventas")}, {plural(cur.units, "juego", "juegos")})
        </Link>{" "}
        ·{" "}
        <Link href={salesHref({ period })} className={link}>
          te costaron {formatBs(cur.costCents)}
        </Link>
      </p>
      <p className="mt-1 flex flex-wrap gap-x-3 gap-y-1 text-sm">
        {CHANNELS.map((c) => (
          <Link key={c.value} href={salesHref({ period, channel: c.value })} className="underline-offset-4 hover:underline">
            {c.label} <span className="font-semibold tabular-nums">{formatBs(data.byChannel[c.value])}</span>
          </Link>
        ))}
        <span className="text-muted-foreground">Envíos cobrados: {formatBs(cur.shippingCents)}</span>
      </p>
      {cur.withoutCostCents > 0 && (
        <p className="mt-3 rounded-xl bg-madera/10 px-3 py-2 text-sm">
          <Link href={salesHref({ period, withoutCost: true })} className="font-semibold underline-offset-4 hover:underline">
            {formatBs(cur.withoutCostCents)} en ventas sin costo anotado
          </Link>
          : no entran en la ganancia{data.bars.some((b) => b.withoutCostCents > 0) && " (en las barras, marcadas con +?)"}
        </p>
      )}
    </section>
  );
}
</file>

<file path="src/features/admin/dashboard/queries.ts">
import { createServerSupabase } from "@/lib/supabase/server";
import type { OrderStatus } from "@/features/orders/status";
import type { Period, Range } from "./period";
import type { Channel, SalesFilter } from "./sales-filter";

// Datos del dashboard y de la página Ventas. Todo se suma en la base (sales_lines / sales_totals).

export type SalesTotals = {
  salesCents: number;
  count: number;
  units: number;
  costCents: number;
  profitCents: number;
  withoutCostCents: number;
  withoutCostUnits: number;
  shippingCents: number;
};

export type Bar = { idx: number; kind: "dia" | "semana" | "mes"; from: string; to: string; salesCents: number; profitCents: number; withoutCostCents: number };

export type TopProduct = { productId: string; name: string; units: number; revenueCents: number; profitCents: number; unitsWithoutCost: number; stock: number };

export type DashboardSales = {
  period: Period;
  range: Range;
  current: SalesTotals;
  previous: SalesTotals;
  byChannel: Record<Channel, number>;
  bars: Bar[];
  top: TopProduct[];
  customers: { buyers: number; new: number; returning: number };
  ordersByStatus: Partial<Record<OrderStatus, number>>;
};

export type Reorder = { supplierName: string; contactName: string | null; whatsapp: string | null; quantity: number };
export type NamedProduct = { productId: string; name: string };

export type DashboardNow = {
  pendingReview: number;
  pendingReviewOver24h: number;
  toDeliver: number;
  purchasesToArrive: number;
  debt: { bobCents: number; usdCents: number };
  runningLow: {
    items: { productId: string; name: string; stock: number; sold30d: number; reorder: Reorder | null }[];
    lowStockCount: number;
    outOfStockCount: number;
  };
  inventory: {
    products: number;
    units: number;
    costValueCents: number;
    saleValueCents: number;
    potentialProfitCents: number;
    withoutCost: { products: number; units: number; items: NamedProduct[] };
    withoutPrice: { products: number; items: NamedProduct[] };
    samplesWithStock: number;
  };
};

export type SaleRow = {
  soldAt: string;
  channel: Channel;
  orderId: string | null;
  orderNumber: number | null;
  manualSaleId: string | null;
  productId: string;
  productName: string;
  quantity: number;
  unitPriceCents: number;
  unitCostCents: number | null;
  profitCents: number | null;
};

export type SalesList = { range: Range; totals: SalesTotals; rowCount: number; rows: SaleRow[] };

export async function getDashboardSales(period: Period): Promise<DashboardSales> {
  const supabase = await createServerSupabase();
  const { data, error } = await supabase.rpc("admin_dashboard_sales", { p_period: period });
  if (error) throw error;
  return data as unknown as DashboardSales;
}

export async function getDashboardNow(): Promise<DashboardNow> {
  const supabase = await createServerSupabase();
  const { data, error } = await supabase.rpc("admin_dashboard_now");
  if (error) throw error;
  return data as unknown as DashboardNow;
}

export async function getSalesList(f: SalesFilter): Promise<SalesList> {
  const supabase = await createServerSupabase();
  const { data, error } = await supabase.rpc("admin_sales_list", {
    p_period: f.period ?? undefined,
    p_from: f.from ?? undefined,
    p_to: f.to ?? undefined,
    p_channel: f.channel ?? undefined,
    p_without_cost: f.withoutCost,
  });
  if (error) throw error;
  return data as unknown as SalesList;
}
</file>

