import { formatBs } from "@/lib/money";
import type { SalesTotals } from "./queries";

export type Comparison = { tone: "up" | "down" | "same" | "neutral"; text: string };

const MISSING = " · la ganancia no se compara porque faltan costos";

/**
 * Línea de comparación con el período anterior. Si alguno de los dos tiene ventas sin costo anotado,
 * la ganancia saldría engañosa (spec §4.2): se comparan las ventas.
 */
export function compareLine(cur: SalesTotals, prev: SalesTotals, prevLabel: string): Comparison {
  if (prev.count === 0) return { tone: "neutral", text: `Sin ventas en ${prevLabel} para comparar` };
  const bySales = cur.withoutCostCents > 0 || prev.withoutCostCents > 0;
  const diff = bySales ? cur.salesCents - prev.salesCents : cur.profitCents - prev.profitCents;
  const suffix = bySales ? MISSING : "";
  if (diff === 0) return { tone: "same", text: `Igual que ${prevLabel}${suffix}` };
  const amount = formatBs(Math.abs(diff));
  const verb = bySales ? "Vendiste " : "";
  return diff > 0
    ? { tone: "up", text: `▲ ${verb}${amount} más que ${prevLabel}${suffix}` }
    : { tone: "down", text: `▼ ${verb}${amount} menos que ${prevLabel}${suffix}` };
}
</file>

<file path="src/features/admin/dashboard/CustomersOrders.tsx">
import type { OrderStatus } from "@/features/orders/status";
import type { DashboardSales } from "./queries";

const box = "rounded-3xl border border-[#eadcc4] bg-papel p-4 sm:p-6";

// Grupos del spec §4.6. Sin enlaces: el número es de los pedidos creados en el período y la lista de Pedidos
// no filtra por fecha, así que mostraría otra cantidad.
const GROUPS: { label: string; statuses: OrderStatus[] }[] = [
  { label: "Esperando pago", statuses: ["esperando_pago"] },
  { label: "En revisión", statuses: ["en_revision"] },
  { label: "Pagado", statuses: ["pagado"] },
  { label: "Enviado o listo", statuses: ["enviado", "listo_para_recoger"] },
  { label: "Entregado", statuses: ["entregado"] },
  { label: "Cancelado o rechazado", statuses: ["cancelado", "rechazado"] },
  { label: "Reembolsado", statuses: ["reembolsado"] },
];

function Stat({ label, value }: { label: string; value: number }) {
  return (
    <div className="rounded-2xl bg-background/50 px-3 py-2">
      <dt className="text-sm text-muted-foreground">{label}</dt>
      <dd className="font-serif text-2xl font-extrabold tabular-nums">{value}</dd>
    </div>
  );
}

/** Clientes de la tienda web y pedidos creados en el período, por estado. */
export function CustomersOrders({ data }: { data: DashboardSales }) {
  const groups = GROUPS.map((g) => ({ label: g.label, n: g.statuses.reduce((sum, st) => sum + (data.ordersByStatus[st] ?? 0), 0) })).filter((g) => g.n > 0);
  return (
    <>
      <section aria-labelledby="clientes" className={box}>
        <h2 id="clientes" className="mb-1 font-serif text-xl font-bold">
          Clientes
        </h2>
        <p className="mb-3 text-sm text-muted-foreground">Solo cuenta la tienda web</p>
        <dl className="grid grid-cols-3 gap-2">
          <Stat label="Compraron" value={data.customers.buyers} />
          <Stat label="Nuevos" value={data.customers.new} />
          <Stat label="Volvieron a comprar" value={data.customers.returning} />
        </dl>
      </section>
      <section aria-labelledby="pedidos-estado" className={box}>
        <h2 id="pedidos-estado" className="mb-1 font-serif text-xl font-bold">
          Pedidos
        </h2>
        <p className="mb-3 text-sm text-muted-foreground">Creados en este período</p>
        {groups.length === 0 ? (
          <p className="text-muted-foreground">No hay pedidos nuevos en este período.</p>
        ) : (
          <ul className="flex flex-wrap gap-2">
            {groups.map((g) => (
              <li key={g.label} className="inline-flex min-h-11 items-center gap-2 rounded-full bg-background/50 px-3 text-sm">
                {g.label}
                <span className="font-bold tabular-nums">{g.n}</span>
              </li>
            ))}
          </ul>
        )}
      </section>
    </>
  );
}
</file>

<file path="src/features/admin/dashboard/InventoryCard.tsx">
import Link from "next/link";
import { formatBs } from "@/lib/money";
import type { DashboardNow, NamedProduct } from "./queries";

function Missing({ title, items, total }: { title: string; items: NamedProduct[]; total: number }) {
  if (total === 0) return null;
  return (
    <details className="mt-2 rounded-xl bg-madera/10 px-3 py-2 text-sm">
      <summary className="cursor-pointer font-semibold">{title}</summary>
      <ul className="mt-2 grid gap-1">
        {items.map((p) => (
          <li key={p.productId}>
            <Link href={`/panel/productos/${p.productId}`} className="text-verde underline-offset-4 hover:underline">
              {p.name}
            </Link>
          </li>
        ))}
        {total > items.length && <li className="text-muted-foreground">y {total - items.length} más</li>}
      </ul>
    </details>
  );
}

/** Cuánto vale lo que hay en la tienda (disponible + apartado), sin los juegos de ejemplo. */
export function InventoryCard({ inv }: { inv: DashboardNow["inventory"] }) {
  const n = (v: number, one: string, many: string) => (v === 1 ? `1 ${one}` : `${v} ${many}`);
  return (
    <section aria-labelledby="inventario" className="rounded-3xl border border-[#eadcc4] bg-papel p-4 sm:p-6">
      <h2 id="inventario" className="mb-1 font-serif text-xl font-bold">
        Inventario
      </h2>
      <p className="text-tinta-suave">
        {n(inv.products, "juego", "juegos")} · {n(inv.units, "unidad", "unidades")}
      </p>
      <dl className="mt-3 grid gap-2">
        <div className="flex justify-between gap-3">
          <dt>Valor a costo</dt>
          <dd className="font-semibold tabular-nums">{formatBs(inv.costValueCents)}</dd>
        </div>
        <div className="flex justify-between gap-3">
          <dt>Valor a precio de venta</dt>
          <dd className="font-semibold tabular-nums">{formatBs(inv.saleValueCents)}</dd>
        </div>
        <div className="flex justify-between gap-3 border-t border-[#eadcc4] pt-2">
          <dt className="font-semibold">Si vendes todo, ganarías</dt>
          <dd className="font-serif text-xl font-extrabold tabular-nums text-verde">{formatBs(inv.potentialProfitCents)}</dd>
        </div>
      </dl>
      {(inv.withoutCost.products > 0 || inv.withoutPrice.products > 0) && (
        <p className="mt-1 text-sm text-muted-foreground">
          Solo cuenta los juegos con costo y precio: faltan {inv.withoutCost.products} sin costo y {inv.withoutPrice.products} sin precio.
        </p>
      )}
      <Missing
        title={`${n(inv.withoutCost.products, "juego", "juegos")} sin costo anotado (${n(inv.withoutCost.units, "unidad", "unidades")})`}
        items={inv.withoutCost.items}
        total={inv.withoutCost.products}
      />
      <Missing title={`${n(inv.withoutPrice.products, "juego", "juegos")} sin precio`} items={inv.withoutPrice.items} total={inv.withoutPrice.products} />
      {inv.samplesWithStock > 0 && (
        <p className="mt-2 text-sm text-muted-foreground">
          No se cuentan {inv.samplesWithStock} juegos de ejemplo; puedes borrarlos en{" "}
          <Link href="/panel/ajustes" className="text-verde underline-offset-4 hover:underline">
            Ajustes
          </Link>
          .
        </p>
      )}
    </section>
  );
}
