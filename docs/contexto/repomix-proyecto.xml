"use client";

import { useRouter } from "next/navigation";
import { useState, useTransition } from "react";
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
import { callAction } from "../call-action";
import { ConfirmButton } from "../ConfirmButton";
import { control, field } from "../settings/shared";
import { centsToBsText } from "../product-schema";
import { formatMoney, type Currency } from "./money";
import {
  applyCreditAction,
  correctArrivalAction,
  receivePurchaseAction,
  recordPaymentAction,
  savePurchaseNotesAction,
  voidPaymentAction,
  voidPurchaseAction,
} from "./purchase-actions";
import type { PurchaseDetail } from "./queries";

type Status = { ok: boolean; text: string } | null;

function StatusLine({ status }: { status: Status }) {
  if (!status) return null;
  return (
    <p role={status.ok ? "status" : "alert"} className={status.ok ? "text-sm font-medium text-verde" : "text-sm font-medium text-rojo"}>
      {status.text}
    </p>
  );
}

const rateText = (rate: number | null) => (rate === null ? "" : String(rate).replace(".", ","));

/** "Llegó" (o "Corregir llegada"): cantidades que llegaron, encomienda, dólar y, al llegar, el saldo. */
function ArrivalDialog({ purchase, mode, open, onOpenChange }: { purchase: PurchaseDetail; mode: "llegada" | "correccion"; open: boolean; onOpenChange: (o: boolean) => void }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  const [payNow, setPayNow] = useState(false);
  const [requestId] = useState(() => crypto.randomUUID());
  const usd = purchase.currency === "USD";
  const [quantities, setQuantities] = useState<Record<string, string>>(() =>
    Object.fromEntries(purchase.items.map((i) => [i.id, String(mode === "llegada" ? i.quantityOrdered : (i.quantityReceived ?? 0))])),
  );
  const [balanceEdited, setBalanceEdited] = useState<string | null>(null);
  // Lo que falta pagar según lo que LLEGÓ (no lo encargado): Σ cantidad × precio − ya pagado.
  const arrivedTotal = purchase.items.reduce((sum, i) => sum + (Number(quantities[i.id]) || 0) * i.unitPriceCents, 0);
  const balanceText = balanceEdited ?? centsToBsText(Math.max(0, arrivedTotal - purchase.paidCents));

  function submit(f: FormData) {
    const arrival = {
      currency: purchase.currency,
      received: purchase.items.map((i) => ({ itemId: i.id, quantity: String(f.get(`q-${i.id}`) ?? "") })),
      shipping: String(f.get("shipping") ?? ""),
      rate: String(f.get("rate") ?? ""),
    };
    const payment =
      mode === "llegada" && payNow
        ? {
            requestId,
            payment: {
              purchaseCurrency: purchase.currency,
              paidOn: new Date().toLocaleDateString("en-CA", { timeZone: "America/La_Paz" }),
              currency: purchase.currency,
              amount: String(f.get("balance") ?? ""),
              rate: arrival.rate,
              note: "Saldo al llegar",
              kind: "pago" as const,
            },
          }
        : null;
    startTransition(async () => {
      const result = await callAction(() => (mode === "llegada" ? receivePurchaseAction(purchase.id, arrival, payment) : correctArrivalAction(purchase.id, arrival)));
      if ("error" in result) return setError(result.error);
      setError(null);
      onOpenChange(false);
      const warning = "warning" in result ? (result.warning as string | undefined) : undefined;
      router.replace(`/panel/compras/${purchase.id}${warning ? `?aviso=${encodeURIComponent(warning)}` : ""}`);
      router.refresh();
    });
  }

  return (
    <Dialog open={open} onOpenChange={(o) => (o || setError(null), onOpenChange(o))}>
      <DialogContent>
        <DialogTitle>{mode === "llegada" ? "Llegó la compra" : "Corregir llegada"}</DialogTitle>
        <DialogDescription>
          {mode === "llegada" ? "Anota cuántas unidades llegaron de cada producto: recién ahora sube el stock." : "Cambia lo que se anotó mal; el stock se ajusta solo."}
        </DialogDescription>
        <form
          className="grid gap-4"
          onSubmit={(e) => {
            e.preventDefault();
            submit(new FormData(e.currentTarget));
          }}
        >
          {purchase.items.map((i) => (
            <label key={i.id} className={field}>
              {`Llegaron de «${i.productName}»`}
              <input
                name={`q-${i.id}`}
                type="number"
                inputMode="numeric"
                min={0}
                value={quantities[i.id] ?? ""}
                onChange={(e) => setQuantities((q) => ({ ...q, [i.id]: e.target.value }))}
                className={control}
              />
              <span className="text-xs font-normal text-muted-foreground">Encargaste {i.quantityOrdered}</span>
            </label>
          ))}
          <label className={field}>
            Costo de la encomienda (Bs)
            <input name="shipping" inputMode="decimal" defaultValue={mode === "correccion" ? centsToBsText(purchase.shippingCents) : ""} placeholder="0" className={control} />
          </label>
          {usd && (
            <label className={field}>
              A cuánto estaba el dólar
              <input name="rate" inputMode="decimal" defaultValue={rateText(purchase.arrivalRate)} placeholder="6,96" className={control} />
            </label>
          )}
          {mode === "llegada" && purchase.debtCents > 0 && (
            <div className="grid gap-2 rounded-xl bg-crema-2/60 p-3">
              <label className="flex min-h-11 items-center gap-2 font-semibold">
                <input type="checkbox" checked={payNow} onChange={(e) => setPayNow(e.target.checked)} className="size-5 accent-verde" />
                Pagar el saldo ahora
              </label>
              {payNow && (
                <label className={field}>
                  Monto del saldo
                  <input name="balance" inputMode="decimal" value={balanceText} onChange={(e) => setBalanceEdited(e.target.value)} className={control} />
                  <span className="text-xs font-normal text-muted-foreground">En {usd ? "dólares, con el dólar de arriba" : "bolivianos"}. Si llegó menos, paga menos.</span>
                </label>
              )}
            </div>
          )}
          {error && (
            <p role="alert" className="text-sm font-medium text-rojo">
              {error}
            </p>
          )}
          <Button type="submit" size="lg" disabled={pending}>
            {pending ? "Guardando…" : mode === "llegada" ? "Guardar llegada" : "Guardar corrección"}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

/** Pago (o devolución del proveedor), en Bs o dólares con el dólar de ese día. */
function PaymentDialog({ purchase, kind, open, onOpenChange }: { purchase: PurchaseDetail; kind: "pago" | "devolucion"; open: boolean; onOpenChange: (o: boolean) => void }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  const [currency, setCurrency] = useState<Currency>(purchase.currency);
  // Se renueva al terminar: un reintento tras una respuesta perdida usa el mismo id (la base no duplica).
  const [requestId, setRequestId] = useState(() => crypto.randomUUID());
  const needsRate = currency === "USD" || purchase.currency === "USD";
  const title = kind === "pago" ? "Registrar pago" : "El proveedor me devolvió";

  function submit(f: FormData) {
    const input = {
      purchaseCurrency: purchase.currency,
      paidOn: String(f.get("paidOn") ?? ""),
      currency,
      amount: String(f.get("amount") ?? ""),
      rate: String(f.get("rate") ?? ""),
      note: String(f.get("note") ?? ""),
      kind,
    };
    startTransition(async () => {
      const result = await callAction(() => recordPaymentAction(requestId, purchase.id, input));
      if ("error" in result) return setError(result.error);
      setError(null);
      setRequestId(crypto.randomUUID());
      onOpenChange(false);
      router.refresh();
    });
  }

  return (
    <Dialog open={open} onOpenChange={(o) => (o || setError(null), onOpenChange(o))}>
      <DialogContent>
        <DialogTitle>{title}</DialogTitle>
        <DialogDescription>
          {purchase.debtCents > 0 ? `Se debe ${formatMoney(purchase.debtCents, purchase.currency)}.` : `Saldo a favor: ${formatMoney(-purchase.debtCents, purchase.currency)}.`}
        </DialogDescription>
        <form
          className="grid gap-4"
          onSubmit={(e) => {
            e.preventDefault();
            submit(new FormData(e.currentTarget));
          }}
        >
          <div className="grid grid-cols-2 gap-3">
            <label className={field}>
              Monto
              <input name="amount" inputMode="decimal" defaultValue={kind === "devolucion" ? centsToBsText(Math.max(0, -purchase.debtCents)) : ""} className={control} />
            </label>
            <div className={field}>
              <label htmlFor={`pay-cur-${kind}`}>Moneda del pago</label>
              <select id={`pay-cur-${kind}`} value={currency} onChange={(e) => setCurrency(e.target.value as Currency)} className={control}>
                <option value="BOB">Bolivianos</option>
                <option value="USD">Dólares</option>
              </select>
            </div>
          </div>
          {needsRate && (
            <label className={field}>
              A cuánto estaba el dólar ese día
              <input name="rate" inputMode="decimal" placeholder="6,96" className={control} />
            </label>
          )}
          <label className={field}>
            Fecha
            <input name="paidOn" type="date" defaultValue={new Date().toLocaleDateString("en-CA", { timeZone: "America/La_Paz" })} className={control} />
          </label>
          <label className={field}>
            Nota (opcional)
            <input name="note" maxLength={300} className={control} />
          </label>
          {error && (
            <p role="alert" className="text-sm font-medium text-rojo">
              {error}
            </p>
          )}
          <Button type="submit" size="lg" disabled={pending}>
            {pending ? "Guardando…" : "Guardar pago"}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

function CreditDialog({ purchase, open, onOpenChange }: { purchase: PurchaseDetail; open: boolean; onOpenChange: (o: boolean) => void }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  const [target, setTarget] = useState(purchase.creditTargets[0]?.id ?? "");
  // Se renueva al terminar: sin recargar, un segundo traspaso no debe reusar el id del primero.
  const [requestId, setRequestId] = useState(() => crypto.randomUUID());
  const targetCurrency = purchase.creditTargets.find((t) => t.id === target)?.currency;
  const needsRate = targetCurrency !== undefined && targetCurrency !== purchase.currency;
  return (
    <Dialog open={open} onOpenChange={(o) => (o || setError(null), onOpenChange(o))}>
      <DialogContent>
        <DialogTitle>Usar el saldo en otra compra</DialogTitle>
        <DialogDescription>Pasa el saldo a favor como pago de otra compra a {purchase.supplier.name}.</DialogDescription>
        <form
          className="grid gap-4"
          onSubmit={(e) => {
            e.preventDefault();
            const rate = String(new FormData(e.currentTarget).get("rate") ?? "");
            startTransition(async () => {
              const result = await callAction(() => applyCreditAction(requestId, purchase.id, target, rate));
              if ("error" in result) return setError(result.error);
              setRequestId(crypto.randomUUID());
              onOpenChange(false);
              router.refresh();
            });
          }}
        >
          <div className={field}>
            <label htmlFor="credit-target">Compra destino</label>
            <select id="credit-target" value={target} onChange={(e) => setTarget(e.target.value)} className={control}>
              {purchase.creditTargets.map((t) => (
                <option key={t.id} value={t.id}>
                  {`${t.orderedOn} · debe ${formatMoney(t.debtCents, t.currency)}`}
                </option>
              ))}
            </select>
          </div>
          {needsRate && (
            <label className={field}>
              A cuánto estaba el dólar
              <input name="rate" inputMode="decimal" placeholder="6,96" className={control} />
            </label>
          )}
          {error && (
            <p role="alert" className="text-sm font-medium text-rojo">
              {error}
            </p>
          )}
          <Button type="submit" size="lg" disabled={pending || !target}>
            {pending ? "Guardando…" : "Usar saldo"}
          </Button>
        </form>
      </DialogContent>
    </Dialog>
  );
}

/** Botones de una compra según su estado. `openArrival`: viene de "Llegó" en la portada de Compras. */
export function PurchaseActions({ purchase, openArrival = false }: { purchase: PurchaseDetail; openArrival?: boolean }) {
  const router = useRouter();
  const [dialog, setDialog] = useState<"llegada" | "correccion" | "pago" | "devolucion" | "saldo" | null>(openArrival && purchase.status === "encargada" ? "llegada" : null);
  const [pending, startTransition] = useTransition();
  const [status, setStatus] = useState<Status>(null);
  const close = (o: boolean) => !o && setDialog(null);
  if (purchase.status === "anulada") return null;

  return (
    <div className="grid gap-3">
      <div className="flex flex-wrap gap-2">
        {purchase.status === "encargada" && (
          <Button size="lg" onClick={() => setDialog("llegada")}>
            Llegó
          </Button>
        )}
        {purchase.status === "recibida" && (
          <Button size="lg" variant="outline" onClick={() => setDialog("correccion")}>
            Corregir llegada
          </Button>
        )}
        <Button size="lg" variant="secondary" onClick={() => setDialog("pago")}>
          Registrar pago
        </Button>
        {purchase.debtCents < 0 && (
          <>
            {purchase.creditTargets.length > 0 && (
              <Button size="lg" variant="secondary" onClick={() => setDialog("saldo")}>
                Usar en otra compra
              </Button>
            )}
            <Button size="lg" variant="secondary" onClick={() => setDialog("devolucion")}>
              El proveedor me devolvió
            </Button>
          </>
        )}
        <ConfirmButton
          label="Anular compra"
          confirmLabel="Sí, anular"
          question={purchase.status === "recibida" ? "¿Anular? Se resta del stock lo que sumó." : "¿Anular esta compra?"}
          disabled={pending}
          onConfirm={() =>
            startTransition(async () => {
              const result = await callAction(() => voidPurchaseAction(purchase.id));
              if ("error" in result) return setStatus({ ok: false, text: result.error });
              router.refresh();
            })
          }
        />
      </div>
      <StatusLine status={status} />
      <ArrivalDialog purchase={purchase} mode="llegada" open={dialog === "llegada"} onOpenChange={close} />
      <ArrivalDialog purchase={purchase} mode="correccion" open={dialog === "correccion"} onOpenChange={close} />
      <PaymentDialog purchase={purchase} kind="pago" open={dialog === "pago"} onOpenChange={close} />
      <PaymentDialog purchase={purchase} kind="devolucion" open={dialog === "devolucion"} onOpenChange={close} />
      {purchase.creditTargets.length > 0 && <CreditDialog purchase={purchase} open={dialog === "saldo"} onOpenChange={close} />}
    </div>
  );
}

export function VoidPaymentButton({ paymentId }: { paymentId: string }) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  return (
    <span className="inline-flex flex-wrap items-center gap-2">
      <ConfirmButton
        label="Anular"
        confirmLabel="Sí, anular"
        question="¿Anular este pago?"
        disabled={pending}
        onConfirm={() =>
          startTransition(async () => {
            const result = await callAction(() => voidPaymentAction(paymentId));
            if ("error" in result) return setError(result.error);
            router.refresh();
          })
        }
      />
      {error && (
        <span role="alert" className="text-sm text-rojo">
          {error}
        </span>
      )}
    </span>
  );
}

export function PurchaseNotes({ purchase }: { purchase: PurchaseDetail }) {
  const [pending, startTransition] = useTransition();
  const [status, setStatus] = useState<Status>(null);
  return (
    <form
      className="grid gap-3"
      onSubmit={(e) => {
        e.preventDefault();
        const f = new FormData(e.currentTarget);
        startTransition(async () => {
          const result = await callAction(() => savePurchaseNotesAction(purchase.id, String(f.get("note") ?? ""), String(f.get("issues") ?? "")));
          setStatus("error" in result ? { ok: false, text: result.error } : { ok: true, text: "Notas guardadas" });
        });
      }}
    >
      <label className={field}>
        Nota
        <textarea name="note" defaultValue={purchase.note ?? ""} maxLength={500} rows={2} className={`${control} h-auto py-2`} />
      </label>
      <label className={field}>
        Detalles por arreglar con el proveedor
        <textarea name="issues" defaultValue={purchase.issuesNote ?? ""} maxLength={1000} rows={2} className={`${control} h-auto py-2`} />
      </label>
      <div className="flex flex-wrap items-center gap-3">
        <Button type="submit" variant="secondary" disabled={pending}>
          Guardar notas
        </Button>
        <StatusLine status={status} />
      </div>
    </form>
  );
}
</file>

<file path="src/features/admin/purchases/PurchaseForm.tsx">
"use client";

import { PlusIcon, Trash2Icon } from "lucide-react";
import { useRouter } from "next/navigation";
import { useState, useTransition } from "react";
import { Button } from "@/components/ui/button";
import { Dialog, DialogContent, DialogDescription, DialogTitle } from "@/components/ui/dialog";
import { cn } from "@/lib/utils";
import { callAction } from "../call-action";
import { control, field } from "../settings/shared";
import type { Currency } from "./money";
import { createPurchaseAction, updatePurchaseAction } from "./purchase-actions";
import { saveSupplierAction } from "./supplier-actions";
import type { PurchaseInput } from "./purchase-schema";

type Option = { id: string; name: string };
type Line = { key: string; productId: string; isNew: boolean; newName: string; categoryId: string; quantity: string; unitPrice: string; search: string };

const fold = (t: string) => t.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "");

/** Alta de proveedor sin salir del formulario (no se pierden las líneas ya escritas). */
function NewSupplierDialog({ open, onOpenChange, onCreated }: { open: boolean; onOpenChange: (o: boolean) => void; onCreated: (s: Option) => void }) {
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  return (
    <Dialog open={open} onOpenChange={onOpenChange}>
      <DialogContent>
        <DialogTitle>Nuevo proveedor</DialogTitle>
        <DialogDescription>Queda guardado y elegido para esta compra.</DialogDescription>
        <div className="grid gap-3">
          <label className={field}>
            Nombre
            <input id="ns-name" maxLength={120} className={control} />
          </label>
          <label className={field}>
            Persona de contacto
            <input id="ns-contact" maxLength={120} className={control} />
          </label>
          <label className={field}>
            WhatsApp
            <input id="ns-whatsapp" type="tel" placeholder="71234567" className={control} />
          </label>
          {error && (
            <p role="alert" className="text-sm font-medium text-rojo">
              {error}
            </p>
          )}
          <Button
            type="button"
            size="lg"
            disabled={pending}
            onClick={() => {
              const value = (id: string) => (document.getElementById(id) as HTMLInputElement | null)?.value ?? "";
              const input = { name: value("ns-name"), contactName: value("ns-contact"), whatsapp: value("ns-whatsapp"), notes: "", isActive: true };
              startTransition(async () => {
                const result = await callAction(() => saveSupplierAction(null, input));
                if ("error" in result) return setError(result.error);
                setError(null);
                onCreated({ id: result.id, name: input.name.trim() });
              });
            }}
          >
            {pending ? "Guardando…" : "Agregar proveedor"}
          </Button>
        </div>
      </DialogContent>
    </Dialog>
  );
}

export type PurchaseFormInitial = {
  id: string;
  supplierId: string;
  orderedOn: string;
  currency: Currency;
  note: string;
  lines: { productId: string; quantity: number; unitPriceText: string }[];
};

const newLine = (): Line => ({ key: crypto.randomUUID(), productId: "", isNew: false, newName: "", categoryId: "", quantity: "1", unitPrice: "", search: "" });

/** Encargar una compra (o corregirla mientras no llegue). Las líneas se agregan de a una: cómodo en el celular. */
export function PurchaseForm({
  suppliers,
  products,
  categories,
  today,
  initial,
}: {
  suppliers: Option[];
  products: Option[];
  categories: Option[];
  today: string;
  initial?: PurchaseFormInitial;
}) {
  const router = useRouter();
  const [pending, startTransition] = useTransition();
  const [error, setError] = useState<string | null>(null);
  const [supplierList, setSupplierList] = useState(suppliers);
  const [supplierId, setSupplierId] = useState(initial?.supplierId ?? "");
  const [supplierDialog, setSupplierDialog] = useState(false);
  const [currency, setCurrency] = useState<Currency>(initial?.currency ?? "BOB");
  const [lines, setLines] = useState<Line[]>(
    initial?.lines.map((l) => ({ ...newLine(), productId: l.productId, quantity: String(l.quantity), unitPrice: l.unitPriceText })) ?? [newLine()],
  );
  const [advanceCurrency, setAdvanceCurrency] = useState<Currency>(initial?.currency ?? "BOB");
  // Un id por envío: un doble toque o una respuesta perdida no crean dos compras ni dos adelantos.
  const [requestIds] = useState(() => ({ purchase: crypto.randomUUID(), advance: crypto.randomUUID() }));

  const update = (key: string, patch: Partial<Line>) => setLines((ls) => ls.map((l) => (l.key === key ? { ...l, ...patch } : l)));
  const needsRate = currency === "USD" || advanceCurrency === "USD";

  function submit(form: FormData) {
    const input: PurchaseInput = {
      supplierId,
      orderedOn: String(form.get("orderedOn") ?? today),
      currency,
      note: String(form.get("note") ?? ""),
      lines: lines.map((l) => ({
        ...(l.isNew ? { newProduct: { name: l.newName, categoryId: l.categoryId } } : l.productId ? { productId: l.productId } : {}),
        quantity: l.quantity,
        unitPrice: l.unitPrice,
      })),
    };
    const amount = String(form.get("advanceAmount") ?? "").trim();
    const advance =
      !initial && amount
        ? {
            requestId: requestIds.advance,
            payment: {
              purchaseCurrency: currency,
              paidOn: input.orderedOn,
              currency: advanceCurrency,
              amount,
              rate: String(form.get("advanceRate") ?? ""),
              note: "Adelanto",
              kind: "pago" as const,
            },
          }
        : null;
    startTransition(async () => {
      if (initial) {
        const result = await callAction(() => updatePurchaseAction(initial.id, input));
        if ("error" in result) return setError(result.error);
        router.push(`/panel/compras/${initial.id}`);
        router.refresh();
        return;
      }
      const result = await callAction(() => createPurchaseAction(requestIds.purchase, input, advance));
      if ("error" in result) return setError(result.error);
      router.push(`/panel/compras/${result.id}${result.warning ? `?aviso=${encodeURIComponent(result.warning)}` : ""}`);
    });
  }

  return (
    <form
      className="grid gap-5"
      noValidate
      onSubmit={(e) => {
        e.preventDefault();
        submit(new FormData(e.currentTarget));
      }}
    >
      <div className="grid gap-3 sm:grid-cols-2">
        <div className={field}>
          <label htmlFor="purchase-supplier">Proveedor</label>
          <select id="purchase-supplier" value={supplierId} onChange={(e) => setSupplierId(e.target.value)} className={control}>
            <option value="" disabled>
              Elige un proveedor
            </option>
            {supplierList.map((s) => (
              <option key={s.id} value={s.id}>
                {s.name}
              </option>
            ))}
          </select>
          <Button type="button" variant="ghost" className="justify-self-start text-verde" onClick={() => setSupplierDialog(true)}>
            <PlusIcon data-icon="inline-start" />
            Nuevo proveedor
          </Button>
        </div>
        <label className={field}>
          Fecha del encargo
          <input name="orderedOn" type="date" defaultValue={initial?.orderedOn ?? today} className={control} />
        </label>
      </div>

      <fieldset className="grid gap-1.5">
        <legend className="mb-1.5 text-sm font-semibold">Moneda de la compra</legend>
        <div className="grid grid-cols-2 gap-2 sm:max-w-sm">
          {(["BOB", "USD"] as const).map((c) => (
            <label
              key={c}
              className={cn("flex min-h-11 cursor-pointer items-center justify-center rounded-xl border-2 font-semibold", currency === c ? "border-verde bg-verde/10 text-verde" : "border-input")}
            >
              <input type="radio" name="currency" value={c} checked={currency === c} onChange={() => (setCurrency(c), setAdvanceCurrency(c))} className="mr-2 size-4 accent-verde" />
              {c === "BOB" ? "Bolivianos" : "Dólares"}
            </label>
          ))}
        </div>
      </fieldset>

      <div className="grid gap-3">
        {lines.map((l, i) => (
          <fieldset key={l.key} aria-label={`Producto ${i + 1}`} className="grid gap-3 rounded-2xl border border-[#eadcc4] bg-papel p-3 sm:grid-cols-[1fr_7rem_9rem]">
            <div className="grid gap-2 sm:col-span-3">
              <label className="flex min-h-11 items-center gap-2 text-sm font-semibold">
                <input type="checkbox" checked={l.isNew} onChange={(e) => update(l.key, { isNew: e.target.checked })} className="size-5 accent-verde" />
                Es un juego nuevo
              </label>
              {l.isNew ? (
                <div className="grid gap-3 sm:grid-cols-2">
                  <label className={field}>
                    Nombre del juego nuevo
                    <input value={l.newName} onChange={(e) => update(l.key, { newName: e.target.value })} maxLength={120} className={control} />
                  </label>
                  <div className={field}>
                    <label htmlFor={`cat-${l.key}`}>Categoría del juego nuevo</label>
                    <select id={`cat-${l.key}`} value={l.categoryId} onChange={(e) => update(l.key, { categoryId: e.target.value })} className={control}>
                      <option value="" disabled>
                        Elige una categoría
                      </option>
                      {categories.map((c) => (
                        <option key={c.id} value={c.id}>
                          {c.name}
                        </option>
                      ))}
                    </select>
                  </div>
                  <p className="text-xs font-normal text-muted-foreground sm:col-span-2">Se crea oculto: no aparece en la tienda hasta que le pongas precio y lo muestres.</p>
                </div>
              ) : (
                <div className={field}>
                  <input
                    aria-label="Buscar producto"
                    value={l.search}
                    onChange={(e) => update(l.key, { search: e.target.value })}
                    placeholder="Buscar producto…"
                    className={`${control} font-normal`}
                  />
                  <label htmlFor={`prod-${l.key}`}>Producto</label>
                  <select id={`prod-${l.key}`} value={l.productId} onChange={(e) => update(l.key, { productId: e.target.value })} className={control}>
                    <option value="" disabled>
                      Elige un producto
                    </option>
                    {products.filter((p) => p.id === l.productId || fold(p.name).includes(fold(l.search.trim()))).map((p) => (
                      <option key={p.id} value={p.id}>
                        {p.name}
                      </option>
                    ))}
                  </select>
                </div>
              )}
            </div>
            <label className={field}>
              Cantidad
              <input value={l.quantity} onChange={(e) => update(l.key, { quantity: e.target.value })} type="number" inputMode="numeric" min={1} className={control} />
            </label>
            <label className={field}>
              Precio por unidad
              <input value={l.unitPrice} onChange={(e) => update(l.key, { unitPrice: e.target.value })} inputMode="decimal" placeholder={currency === "BOB" ? "Bs" : "US$"} className={control} />
            </label>
            {lines.length > 1 && (
              <Button type="button" variant="ghost" className="self-end text-rojo hover:bg-rojo/10" onClick={() => setLines((ls) => ls.filter((x) => x.key !== l.key))}>
                <Trash2Icon aria-hidden />
                Quitar
              </Button>
            )}
          </fieldset>
        ))}
        <Button type="button" variant="secondary" className="justify-self-start" onClick={() => setLines((ls) => [...ls, newLine()])}>
          <PlusIcon data-icon="inline-start" />
          Agregar otro producto
        </Button>
      </div>

      {!initial && (
        <fieldset aria-label="Adelanto (opcional)" className="grid gap-3 rounded-2xl border border-[#eadcc4] bg-papel p-3 sm:grid-cols-3">
          <legend className="px-1 text-sm font-semibold">Adelanto (opcional)</legend>
          <label className={field}>
            Monto del adelanto
            <input name="advanceAmount" inputMode="decimal" className={control} />
          </label>
          <div className={field}>
            <label htmlFor="advance-currency">Moneda del adelanto</label>
            <select id="advance-currency" value={advanceCurrency} onChange={(e) => setAdvanceCurrency(e.target.value as Currency)} className={control}>
              <option value="BOB">Bolivianos</option>
              <option value="USD">Dólares</option>
            </select>
          </div>
          {needsRate && (
            <label className={field}>
              A cuánto estaba el dólar
              <input name="advanceRate" inputMode="decimal" placeholder="6,96" className={control} />
            </label>
          )}
        </fieldset>
      )}

      <label className={field}>
        Nota
        <textarea name="note" defaultValue={initial?.note ?? ""} maxLength={500} rows={2} className={`${control} h-auto py-2`} />
      </label>

      {error && (
        <p role="alert" className="text-sm font-medium text-rojo">
          {error}
        </p>
      )}
      <NewSupplierDialog
        open={supplierDialog}
        onOpenChange={setSupplierDialog}
        onCreated={(s) => {
          setSupplierList((list) => [...list, s].sort((a, b) => a.name.localeCompare(b.name)));
          setSupplierId(s.id);
          setSupplierDialog(false);
        }}
      />
      <Button type="submit" size="lg" disabled={pending} className="justify-self-start">
        {pending ? "Guardando…" : initial ? "Guardar cambios" : "Guardar compra"}
      </Button>
    </form>
  );
}
</file>

<file path="src/features/admin/purchases/queries.ts">
import { createServerSupabase } from "@/lib/supabase/server";
import type { Currency } from "./money";

// Consultas de compras y proveedores (solo admin: RLS y funciones admin_* deciden qué se ve).

export type Debt = { BOB: number; USD: number };
const noDebt = (): Debt => ({ BOB: 0, USD: 0 });

/** Lo que se debe por proveedor (solo deudas positivas, separadas por moneda). */
async function debtsBySupplier(): Promise<Map<string, Debt>> {
  const supabase = await createServerSupabase();
  const { data, error } = await supabase.from("purchase_balances").select("supplier_id, currency, debt_cents").gt("debt_cents", 0);
  if (error) throw error;
  const out = new Map<string, Debt>();
  for (const r of data) {
    const d = out.get(r.supplier_id!) ?? noDebt();
    d[r.currency as Currency] += Number(r.debt_cents);
    out.set(r.supplier_id!, d);
  }
  return out;
}

export type SupplierRow = { id: string; name: string; contactName: string | null; whatsapp: string | null; isActive: boolean; debt: Debt };

export async function listSuppliers(): Promise<SupplierRow[]> {
  const supabase = await createServerSupabase();
  const [{ data, error }, debts] = await Promise.all([
    supabase.from("suppliers").select("id, name, contact_name, whatsapp, is_active").order("is_active", { ascending: false }).order("name"),
    debtsBySupplier(),
  ]);
  if (error) throw error;
  return data.map((s) => ({
    id: s.id,
    name: s.name,
    contactName: s.contact_name,
    whatsapp: s.whatsapp,
    isActive: s.is_active,
    debt: debts.get(s.id) ?? noDebt(),
  }));
}

export type SupplierPurchase = { id: string; orderedOn: string; status: string; currency: Currency; totalCents: number; debtCents: number };
export type SupplierDetail = SupplierRow & { notes: string | null; purchases: SupplierPurchase[] };

export async function getSupplier(id: string): Promise<SupplierDetail | null> {
  if (!/^[0-9a-f-]{36}$/i.test(id)) return null;
  const supabase = await createServerSupabase();
  const [{ data: s }, { data: purchases }, { data: balances }] = await Promise.all([
    supabase.from("suppliers").select("*").eq("id", id).maybeSingle(),
    supabase.from("purchases").select("id, ordered_on, status, currency").eq("supplier_id", id).order("ordered_on", { ascending: false }).limit(50),
    supabase.from("purchase_balances").select("id, total_cents, debt_cents, currency").eq("supplier_id", id),
  ]);
  if (!s) return null;
  const byId = new Map((balances ?? []).map((b) => [b.id!, b]));
  const debt = noDebt();
  for (const b of balances ?? []) if (Number(b.debt_cents) > 0) debt[b.currency as Currency] += Number(b.debt_cents);
  return {
    id: s.id,
    name: s.name,
    contactName: s.contact_name,
    whatsapp: s.whatsapp,
    isActive: s.is_active,
    notes: s.notes,
    debt,
    purchases: (purchases ?? []).map((p) => ({
      id: p.id,
      orderedOn: p.ordered_on,
      status: p.status,
      currency: p.currency as Currency,
      totalCents: Number(byId.get(p.id)?.total_cents ?? 0),
      debtCents: Number(byId.get(p.id)?.debt_cents ?? 0),
    })),
  };
}

// Compras ----------------------------------------------------------------------------------------------

const UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

/** Hoy en La Paz (YYYY-MM-DD). */
export function todayLaPaz(): string {
  return new Date().toLocaleDateString("en-CA", { timeZone: "America/La_Paz" });
}

function daysBetween(from: string, to: string): number {
  return Math.max(0, Math.round((Date.parse(to) - Date.parse(from)) / 86_400_000));
}

export type PendingPurchase = { id: string; supplierName: string; orderedOn: string; daysWaiting: number; currency: Currency; totalCents: number };
export type PurchasesOverview = { debts: { supplierId: string; name: string; debt: Debt }[]; totals: Debt; pending: PendingPurchase[] };

/** Portada de Compras: lo que debo (por proveedor y moneda) y lo que falta llegar. */
export async function getPurchasesOverview(): Promise<PurchasesOverview> {
  const supabase = await createServerSupabase();
  const [{ data: balances, error }, { data: suppliers }, { data: pending }] = await Promise.all([
    supabase.from("purchase_balances").select("id, supplier_id, currency, status, total_cents, debt_cents"),
    supabase.from("suppliers").select("id, name"),
    supabase.from("purchases").select("id, supplier_id, ordered_on, currency").eq("status", "encargada").order("ordered_on"),
  ]);
  if (error) throw error;
  const names = new Map((suppliers ?? []).map((s) => [s.id, s.name]));
  const totals = noDebt();
  const bySupplier = new Map<string, Debt>();
  for (const b of balances ?? []) {
    const debt = Number(b.debt_cents);
    if (debt <= 0) continue;
    const d = bySupplier.get(b.supplier_id!) ?? noDebt();
    d[b.currency as Currency] += debt;
    totals[b.currency as Currency] += debt;
    bySupplier.set(b.supplier_id!, d);
  }
  const totalById = new Map((balances ?? []).map((b) => [b.id!, Number(b.total_cents)]));
  const today = todayLaPaz();
  return {
    debts: [...bySupplier.entries()]
      .map(([supplierId, debt]) => ({ supplierId, name: names.get(supplierId) ?? "", debt }))
      .sort((a, b) => a.name.localeCompare(b.name)),
    totals,
    pending: (pending ?? []).map((p) => ({
      id: p.id,
      supplierName: names.get(p.supplier_id) ?? "",
      orderedOn: p.ordered_on,
      daysWaiting: daysBetween(p.ordered_on, today),
      currency: p.currency as Currency,
      totalCents: totalById.get(p.id) ?? 0,
    })),
  };
}

export type PurchaseRow = {
  id: string;
  supplierName: string;
  orderedOn: string;
  status: "encargada" | "recibida" | "anulada";
  currency: Currency;
  totalCents: number;
  debtCents: number;
  products: string;
};

/** Historial: las 100 últimas, con buscador por proveedor o producto. */
export async function listPurchases({ q }: { q?: string } = {}): Promise<PurchaseRow[]> {
  const supabase = await createServerSupabase();
  const [{ data, error }, { data: balances }] = await Promise.all([
    supabase
      .from("purchases")
      .select("id, ordered_on, status, currency, created_at, suppliers(name), purchase_items(products(name))")
      .order("created_at", { ascending: false })
      .limit(100),
    supabase.from("purchase_balances").select("id, total_cents, debt_cents"),
  ]);
  if (error) throw error;
  const byId = new Map((balances ?? []).map((b) => [b.id!, b]));
  const needle = q?.trim().toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "");
  return data
    .map((p) => ({
      id: p.id,
      supplierName: p.suppliers?.name ?? "",
      orderedOn: p.ordered_on,
      status: p.status as PurchaseRow["status"],
      currency: p.currency as Currency,
      totalCents: Number(byId.get(p.id)?.total_cents ?? 0),
      debtCents: Number(byId.get(p.id)?.debt_cents ?? 0),
      products: p.purchase_items.map((i) => i.products?.name ?? "").join(", "),
    }))
    .filter((p) => !needle || `${p.supplierName} ${p.products}`.toLowerCase().normalize("NFD").replace(/[̀-ͯ]/g, "").includes(needle));
}

export type PurchaseItem = {
  id: string;
  productId: string;
  productName: string;
  productVisible: boolean;
  quantityOrdered: number;
  quantityReceived: number | null;
  unitPriceCents: number;
  unitCostCents: number | null;
};
export type PurchasePayment = {
  id: string;
  paidOn: string;
  currency: Currency;
  amountCents: number;
  rate: number | null;
  amountPurchaseCents: number;
  kind: "pago" | "devolucion" | "saldo_usado" | "saldo_recibido";
  note: string | null;
  voided: boolean;
};
export type PurchaseDetail = {
  id: string;
  supplier: { id: string; name: string; contactName: string | null; whatsapp: string | null };
  orderedOn: string;
  currency: Currency;
  status: PurchaseRow["status"];
  arrivalRate: number | null;
  shippingCents: number;
  note: string | null;
  issuesNote: string | null;
  receivedAt: string | null;
  items: PurchaseItem[];
  payments: PurchasePayment[];
  totalCents: number;
  paidCents: number;
  debtCents: number;
  /** Otras compras del mismo proveedor que deben algo (destino del saldo a favor). */
  creditTargets: { id: string; orderedOn: string; currency: Currency; debtCents: number }[];
};

export async function getPurchase(id: string): Promise<PurchaseDetail | null> {
  if (!UUID.test(id)) return null;
  const supabase = await createServerSupabase();
  const { data: p } = await supabase
    .from("purchases")
    .select("*, suppliers(id, name, contact_name, whatsapp), purchase_items(*, products(name, is_active)), purchase_payments(*)")
    .eq("id", id)
    .maybeSingle();
  if (!p || !p.suppliers) return null;
  const [{ data: balance }, { data: others }] = await Promise.all([
    supabase.from("purchase_balances").select("total_cents, paid_cents, debt_cents").eq("id", id).maybeSingle(),
    supabase.from("purchase_balances").select("id, debt_cents, currency").eq("supplier_id", p.supplier_id).gt("debt_cents", 0).neq("id", id),
  ]);
  const { data: otherDates } = others?.length
    ? await supabase.from("purchases").select("id, ordered_on").in("id", others.map((o) => o.id!))
    : { data: [] };
  const dateOf = new Map((otherDates ?? []).map((o) => [o.id, o.ordered_on]));
  const total = Number(balance?.total_cents ?? 0);
  const paid = Number(balance?.paid_cents ?? 0);
  return {
    id: p.id,
    supplier: { id: p.suppliers.id, name: p.suppliers.name, contactName: p.suppliers.contact_name, whatsapp: p.suppliers.whatsapp },
    orderedOn: p.ordered_on,
    currency: p.currency as Currency,
    status: p.status as PurchaseRow["status"],
    arrivalRate: p.arrival_rate === null ? null : Number(p.arrival_rate),
    shippingCents: p.shipping_cents ?? 0,
    note: p.note,
    issuesNote: p.issues_note,
    receivedAt: p.received_at,
    items: [...p.purchase_items]
      .sort((a, b) => (a.products?.name ?? "").localeCompare(b.products?.name ?? ""))
      .map((i) => ({
        id: i.id,
        productId: i.product_id,
        productName: i.products?.name ?? "",
        productVisible: i.products?.is_active ?? false,
        quantityOrdered: i.quantity_ordered,
        quantityReceived: i.quantity_received,
        unitPriceCents: i.unit_price_cents,
        unitCostCents: i.line_cost_cents !== null && i.quantity_received ? Math.round(Number(i.line_cost_cents) / i.quantity_received) : null,
      })),
    payments: [...p.purchase_payments]
      .sort((a, b) => a.created_at.localeCompare(b.created_at))
      .map((x) => ({
        id: x.id,
        paidOn: x.paid_on,
        currency: x.currency as Currency,
        amountCents: x.amount_cents,
        rate: x.rate === null ? null : Number(x.rate),
        amountPurchaseCents: x.amount_purchase_cents,
        kind: x.kind as PurchasePayment["kind"],
        note: x.note,
        voided: x.voided_at !== null,
      })),
    totalCents: total,
    paidCents: paid,
    debtCents: total - paid,
    creditTargets: (others ?? []).map((o) => ({ id: o.id!, orderedOn: dateOf.get(o.id!) ?? "", currency: o.currency as Currency, debtCents: Number(o.debt_cents) })),
  };
}

/** Lo que necesita el formulario de compra. */
export async function getPurchaseFormData() {
  const supabase = await createServerSupabase();
  const [suppliers, products, categories] = await Promise.all([
    supabase.from("suppliers").select("id, name").eq("is_active", true).order("name"),
    supabase.from("products").select("id, name").order("name"),
    supabase.from("categories").select("id, name").order("sort_order").order("name"),
  ]);
  return { suppliers: suppliers.data ?? [], products: products.data ?? [], categories: categories.data ?? [] };
}
