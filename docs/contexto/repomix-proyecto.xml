-- Medianoche de La Paz --------------------------------------------------------------------------------------
select pg_temp.manual('t.m2', '00000000-0000-0000-0000-00000000000b', 1, 2000, 'whatsapp', '2026-10-11 23:30-04');
select pg_temp.as_user('00000000-0000-0000-0000-0000000000ad');
