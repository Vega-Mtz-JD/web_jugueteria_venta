import { test, expect } from "@playwright/test";

const cards = (page: import("@playwright/test").Page) => page.getByTestId("product-card");

test.describe("catálogo", () => {
  test("muestra todos los productos activos", async ({ page }) => {
    await page.goto("/catalogo");
    await expect(page.getByText("17 juegos")).toBeVisible();
    await expect(cards(page)).toHaveCount(17);
  });

  test("filtra por categoría con las chips", async ({ page }) => {
    await page.goto("/catalogo");
    await page.getByRole("link", { name: "Cartas", exact: true }).click();
    await expect(page).toHaveURL(/categoria=cartas/);
    await expect(page.getByText("3 juegos")).toBeVisible();
    for (const card of await cards(page).all()) await expect(card).toContainText("Cartas");
  });

  test("el buscador encuentra sin tildes", async ({ page }) => {
    await page.goto("/catalogo");
    await page.getByRole("searchbox", { name: "Buscar juegos" }).fill("catan");
    await expect(page).toHaveURL(/q=catan/);
    await expect(cards(page)).toHaveCount(1);
    await expect(cards(page).first()).toContainText("Catán");
  });

  test("parámetros inválidos se ignoran y se muestra el catálogo", async ({ page }) => {
    const res = await page.goto("/catalogo?precio_min=abc&jugadores=-3&categoria=no-existe");
    expect(res?.status()).toBe(200);
    await expect(page.getByText("17 juegos")).toBeVisible();
  });

  test("el estado vacío permite limpiar los filtros", async ({ page }) => {
    await page.goto("/catalogo?q=zzzz");
    await expect(page.getByText("No encontramos juegos con esos filtros")).toBeVisible();
    await page.getByRole("main").getByRole("link", { name: "Limpiar filtros" }).first().click();
    await expect(page.getByText("17 juegos")).toBeVisible();
    await expect(page.getByRole("searchbox", { name: "Buscar juegos" })).toHaveValue("");
  });

  test("solo ofertas", async ({ page }) => {
    await page.goto("/catalogo?ofertas=1");
    await expect(cards(page)).toHaveCount(1);
    await expect(cards(page).first()).toContainText("Scrabble");
  });

  test("el producto sin fotos usa la imagen de relleno", async ({ page }) => {
    await page.goto("/catalogo?q=4x4");
    await expect(cards(page).first().locator("img")).toHaveAttribute("src", /placeholder\.svg/);
  });

  test("en celular el nombre largo se recorta y no hay scroll horizontal", async ({ page, isMobile }) => {
    test.skip(!isMobile, "solo celular");
    await page.goto("/catalogo?categoria=casino");
    const title = cards(page).filter({ hasText: "Ruleta" }).locator("h3");
    await expect(title).toHaveCSS("-webkit-line-clamp", "2");
    const overflow = await page.evaluate(() => document.documentElement.scrollWidth - document.documentElement.clientWidth);
    expect(overflow).toBeLessThanOrEqual(0);
  });
});
</file>

<file path="e2e/pago.spec.ts">
import path from "node:path";
import { test, expect } from "@playwright/test";
import { chooseProof, loginAsNewUser } from "./helpers/session";
import { createOrderFor, createTestUser, orderStatus } from "./helpers/supabase-admin";

const fixture = (name: string) => path.join(__dirname, "fixtures", name);

test.describe("pago con QR", () => {
  test("muestra el código, el total y los QR; sin captura no se envía", async ({ page }) => {
    const user = await loginAsNewUser(page);
    const order = await createOrderFor(user.id);
    await page.goto(`/pedidos/${order.id}/pago`);
    await expect(page.getByText(`#${String(order.number).padStart(4, "0")}`).first()).toBeVisible();
    await expect(page.getByText("Bs 35").first()).toBeVisible();
    await expect(page.getByText(/glosa/)).toBeVisible();
    for (const wallet of ["Yape", "Altoke", "Yasta"]) await expect(page.getByRole("tab", { name: wallet })).toBeVisible();
    await expect(page.getByRole("button", { name: "Enviar pedido" })).toBeDisabled();
  });

  test("subir la captura deja el pedido en revisión", async ({ page }) => {
    const user = await loginAsNewUser(page);
    const order = await createOrderFor(user.id);
    await page.goto(`/pedidos/${order.id}/pago`);
    await chooseProof(page, fixture("captura.png"));
    await expect(page.getByRole("img", { name: "Vista previa de la captura" })).toBeVisible();
    await page.getByRole("button", { name: "Enviar pedido" }).click();
    await expect(page).toHaveURL(new RegExp(`/pedidos/${order.id}$`), { timeout: 15000 }); // comprime y sube la imagen
    expect(await orderStatus(order.id)).toBe("en_revision");
  });

  test("un PDF se rechaza antes de subirlo", async ({ page }) => {
    const user = await loginAsNewUser(page);
    const order = await createOrderFor(user.id);
    await page.goto(`/pedidos/${order.id}/pago`);
    await chooseProof(page, fixture("comprobante.pdf"), false);
    await expect(page.getByText("Sube una imagen (foto o captura de pantalla)")).toBeVisible();
    await expect(page.getByRole("button", { name: "Enviar pedido" })).toBeDisabled();
  });

  test("el pedido de otra persona no se puede ver", async ({ page }) => {
    const other = await createTestUser("Otra Persona");
    const order = await createOrderFor(other.id);
    await loginAsNewUser(page);
    await page.goto(`/pedidos/${order.id}/pago`);
    await expect(page.getByText("No encontramos ese pedido")).toBeVisible();
    await expect(page.getByText("Bs 35")).toHaveCount(0);
  });
});
</file>

