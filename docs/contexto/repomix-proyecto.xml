grant execute on function public.create_order(uuid, jsonb, jsonb, jsonb) to authenticated;
grant execute on function public.submit_payment_proof(uuid, text) to authenticated;
grant execute on function public.cancel_order_by_customer(uuid) to authenticated;

-- Cada 10 minutos (pg_cron de Supabase: no depende del hosting).
