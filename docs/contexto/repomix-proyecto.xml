<file path="supabase/tests/catalogo_rls.test.sql">
-- Esquema del catálogo y reglas de seguridad (RLS).
-- Cada prueba crea sus propios datos (slugs "t-...") y todo se deshace al final.
begin;
create extension if not exists pgtap with schema extensions;
select plan(21);

-- Estructura -------------------------------------------------------------
select has_table('public', 'profiles', 'existe profiles');
select has_table('public', 'categories', 'existe categories');
select has_table('public', 'products', 'existe products');
select has_table('public', 'product_images', 'existe product_images');
select has_table('public', 'store_settings', 'existe store_settings');
select ok(
  (select bool_and(relrowsecurity) from pg_class
   where oid in ('public.profiles'::regclass, 'public.categories'::regclass, 'public.products'::regclass,
                 'public.product_images'::regclass, 'public.store_settings'::regclass)),
  'RLS activo en las cinco tablas'
);

-- Datos de la prueba (como postgres) -------------------------------------
insert into auth.users (id, email) values
  ('00000000-0000-0000-0000-0000000000a1', 'admin@test.bo'),
  ('00000000-0000-0000-0000-0000000000b1', 'cliente@test.bo');
update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000a1';
insert into public.categories (id, name, slug) values ('00000000-0000-0000-0000-0000000000c1', 'Test', 't-cat');
insert into public.products (name, slug, category_id, price_cents, is_active, is_sample) values
  ('Activo',   't-activo',   '00000000-0000-0000-0000-0000000000c1', 1000, true,  false),
  ('Inactivo', 't-inactivo', '00000000-0000-0000-0000-0000000000c1', 1000, false, false),
  ('Muestra',  't-muestra',  '00000000-0000-0000-0000-0000000000c1', 1000, true,  true);
insert into public.store_settings (store_name) values ('Tienda test') on conflict (id) do nothing;
select set_config('test.n_samples', (select count(*) from public.products where is_sample)::text, true);

select is(
  (select role from public.profiles where id = '00000000-0000-0000-0000-0000000000b1'), 'customer',
  'al registrarse un usuario se crea su perfil como customer'
);

-- Visitante sin cuenta (anon) --------------------------------------------
set local role anon;
select is((select count(*)::int from public.products where slug = 't-activo'), 1, 'anon ve productos activos');
select is((select count(*)::int from public.products where slug = 't-inactivo'), 0, 'anon no ve productos inactivos');
select throws_ok(
  $$insert into public.products (name, slug, category_id, price_cents)
    values ('x', 't-x', '00000000-0000-0000-0000-0000000000c1', 1)$$,
  '42501', null, 'anon no puede crear productos'
);
select is_empty($$update public.store_settings set store_name = 'hack' returning 1$$, 'anon no puede editar los ajustes');
reset role;

-- Cliente con cuenta, no admin -------------------------------------------
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-0000-0000-0000000000b1", "role": "authenticated"}';
select throws_ok(
  $$update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000b1'$$,
  '42501', null, 'un cliente no puede hacerse admin'
);
select is((select count(*)::int from public.profiles), 1, 'un cliente solo ve su propio perfil');
select throws_ok($$select public.delete_sample_products()$$, '42501', null, 'un cliente no puede borrar los productos de prueba');
reset role;

-- Administrador -----------------------------------------------------------
set local role authenticated;
set local request.jwt.claims = '{"sub": "00000000-0000-0000-0000-0000000000a1", "role": "authenticated"}';
select lives_ok(
  $$insert into public.products (name, slug, category_id, price_cents)
    values ('Admin', 't-admin', '00000000-0000-0000-0000-0000000000c1', 500)$$,
  'admin puede crear productos'
);
select is((select count(*)::int from public.products where slug = 't-inactivo'), 1, 'admin ve productos inactivos');
select is(public.delete_sample_products(), current_setting('test.n_samples')::int, 'delete_sample_products devuelve cuántos borró');
select is(
  (select count(*)::int from public.products where slug in ('t-activo', 't-inactivo', 't-admin')), 3,
  'delete_sample_products no toca los productos reales'
);
reset role;

-- Restricciones y búsqueda (como postgres) -------------------------------
select throws_ok(
  $$insert into public.products (name, slug, category_id, price_cents, min_players, max_players)
    values ('x', 't-x1', '00000000-0000-0000-0000-0000000000c1', 1, 4, 2)$$,
  '23514', null, 'max_players no puede ser menor que min_players'
);
select throws_ok(
  $$insert into public.products (name, slug, category_id, price_cents, compare_at_cents)
    values ('x', 't-x2', '00000000-0000-0000-0000-0000000000c1', 1000, 1000)$$,
  '23514', null, 'el precio anterior debe ser mayor que el precio'
);
insert into public.products (name, slug, category_id, price_cents)
  values ('Catán Junior', 't-catan', '00000000-0000-0000-0000-0000000000c1', 1000);
select is((select search_text from public.products where slug = 't-catan'), 'catan junior', 'search_text queda en minúsculas y sin tildes');

select * from finish();
rollback;
</file>

<file path="supabase/tests/compras_correcciones.test.sql">
-- Correcciones de la revisión final del plan 3B.
begin;
create extension if not exists pgtap with schema extensions;
select no_plan();

insert into auth.users (id, email) values ('00000000-0000-0000-0000-0000000000ad', 'admin@test.bo');
update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000ad';
insert into public.categories (id, name, slug) values ('00000000-0000-0000-0000-0000000000ca', 'Test', 't-cat');
insert into public.products (id, name, slug, category_id, price_cents, stock) values
  ('00000000-0000-0000-0000-000000000011', 'H', 't-ph', '00000000-0000-0000-0000-0000000000ca', 20000, 0);
insert into public.suppliers (id, name) values
  ('00000000-0000-0000-0000-0000000005b1', 'Proveedor Uno'),
  ('00000000-0000-0000-0000-0000000005b2', 'Proveedor Dos');

select set_config('role', 'authenticated', true);
select set_config('request.jwt.claims', json_build_object('sub', '00000000-0000-0000-0000-0000000000ad', 'role', 'authenticated')::text, true);
create function pg_temp.compra(k text, cur text, lines jsonb) returns void language plpgsql as $$
begin
  perform set_config(k, public.admin_create_purchase(gen_random_uuid(), '00000000-0000-0000-0000-0000000005b1', current_date, cur, null, lines)::text, true);
end $$;
create function pg_temp.pagar(k text, cur text, amount int, rate numeric, kind text default 'pago') returns uuid language sql as $$
  select public.admin_record_payment(gen_random_uuid(), current_setting(k)::uuid, current_date, cur, amount, rate, null, kind)
$$;
create function pg_temp.h(qty int, price int) returns jsonb language sql as $$
  select jsonb_build_array(jsonb_build_object('product_id', '00000000-0000-0000-0000-000000000011', 'quantity', qty, 'unit_price_cents', price))
$$;

-- 1) La moneda o el proveedor no cambian si ya hay pagos (la deuda quedaría mal) ---------------------------
select pg_temp.compra('t.a', 'BOB', pg_temp.h(10, 1000));
select pg_temp.pagar('t.a', 'USD', 1000, 6.96);
select throws_like(format($$select public.admin_update_purchase('%s', '00000000-0000-0000-0000-0000000005b1', current_date, 'USD', null, '%s')$$, current_setting('t.a'), pg_temp.h(10, 1000)),
  'Primero anula los pagos para cambiar la moneda', 'no se cambia la moneda con pagos');
select throws_like(format($$select public.admin_update_purchase('%s', '00000000-0000-0000-0000-0000000005b2', current_date, 'BOB', null, '%s')$$, current_setting('t.a'), pg_temp.h(10, 1000)),
  'Primero anula los pagos para cambiar el proveedor', 'ni el proveedor');
select lives_ok(format($$select public.admin_update_purchase('%s', '00000000-0000-0000-0000-0000000005b1', current_date, 'BOB', 'nota', '%s')$$, current_setting('t.a'), pg_temp.h(8, 1000)),
  'sí se corrigen las líneas y la nota');
select pg_temp.compra('t.b', 'BOB', pg_temp.h(1, 1000));
select lives_ok(format($$select public.admin_update_purchase('%s', '00000000-0000-0000-0000-0000000005b1', current_date, 'USD', null, '%s')$$, current_setting('t.b'), pg_temp.h(1, 1000)),
  'sin pagos, la moneda se corrige');

-- 3) Un juego creado desde una compra anulada se borra de verdad; en una compra viva, se oculta -----------------
select pg_temp.compra('t.n', 'BOB', '[{"new_product":{"name":"Juego que no llegó","category_id":"00000000-0000-0000-0000-0000000000ca"},"quantity":1,"unit_price_cents":1000}]');
select set_config('t.np', (select id::text from public.products where name = 'Juego que no llegó'), true);
select public.admin_void_purchase(current_setting('t.n')::uuid);
select is(public.admin_delete_product(current_setting('t.np')::uuid), 'borrado', 'el juego de una compra anulada se borra');
select is((select count(*)::int from public.products where name = 'Juego que no llegó'), 0, 'ya no existe');
select pg_temp.compra('t.v', 'BOB', '[{"new_product":{"name":"Juego encargado vivo","category_id":"00000000-0000-0000-0000-0000000000ca"},"quantity":1,"unit_price_cents":1000}]');
select is(public.admin_delete_product((select id from public.products where name = 'Juego encargado vivo')), 'oculto', 'en una compra viva solo se oculta');

-- 6) Un dólar mal escrito no deja costos negativos ------------------------------------------------------------------
select pg_temp.compra('t.u', 'USD', pg_temp.h(10, 1000));
select public.admin_receive_purchase(current_setting('t.u')::uuid, null, 0, 6.96);
select pg_temp.pagar('t.u', 'USD', 12000, 6.96);
select throws_like($$select pg_temp.pagar('t.u', 'USD', 2000, 69.6, 'devolucion')$$, 'Revisa a cuánto estaba el dólar%', 'una devolución a 69,6 se rechaza');
select lives_ok($$select pg_temp.pagar('t.u', 'USD', 2000, 6.96, 'devolucion')$$, 'a 6,96 sí');
select ok((select bool_and(line_cost_cents >= 0) from public.purchase_items where purchase_id = current_setting('t.u')::uuid), 'costos nunca negativos');

-- 11) Saldo entre compras en dólares: sin dólar nuevo, con el dólar de lo que se pagó ---------------------------------
select pg_temp.compra('t.x', 'USD', pg_temp.h(10, 1000));
select public.admin_receive_purchase(current_setting('t.x')::uuid, null, 0, 7.00);
select pg_temp.pagar('t.x', 'USD', 11000, 6.96);
select pg_temp.compra('t.y', 'USD', pg_temp.h(1, 1000));
select lives_ok(format($$select public.admin_apply_credit(gen_random_uuid(), '%s', '%s', null)$$, current_setting('t.x'), current_setting('t.y')), 'USD → USD no pide dólar');
select is((select amount_bob_cents from public.purchase_payments where purchase_id = current_setting('t.y')::uuid and kind = 'saldo_recibido'), 6960::bigint, 'el saldo vale lo que se pagó por él: US$ 10 a 6,96');
select is((select sum(amount_bob_cents)::bigint from public.purchase_payments where purchase_id in (current_setting('t.x')::uuid, current_setting('t.y')::uuid) and voided_at is null),
  76560::bigint, 'los Bs que salieron del bolsillo no cambian');
select is((select sum(line_cost_cents)::bigint from public.purchase_items where purchase_id = current_setting('t.x')::uuid), 69600::bigint, 'el origen cuesta lo que pagó por él: 76560 − 6960');

-- Saldo entre monedas distintas: la suma de Bs se conserva
select pg_temp.compra('t.p', 'BOB', pg_temp.h(1, 1000));
select pg_temp.pagar('t.p', 'BOB', 1700, null);
select pg_temp.compra('t.q', 'USD', pg_temp.h(1, 1000));
select lives_ok(format($$select public.admin_apply_credit(gen_random_uuid(), '%s', '%s', 7.00)$$, current_setting('t.p'), current_setting('t.q')), 'Bs → US$ con dólar');
select is((select amount_purchase_cents from public.purchase_payments where purchase_id = current_setting('t.q')::uuid and kind = 'saldo_recibido'), 100, 'Bs 7 a 7,00 = US$ 1');
select is((select sum(amount_bob_cents)::bigint from public.purchase_payments where purchase_id in (current_setting('t.p')::uuid, current_setting('t.q')::uuid) and voided_at is null),
  1700::bigint, 'los Bs se conservan');

-- 12) La regla «visible con precio» está validada para todas las filas ------------------------------------------------
select set_config('role', 'postgres', true);
select ok((select convalidated from pg_constraint where conname = 'products_visible_price'), 'products_visible_price validada');

select * from finish();
rollback;
</file>

<file path="supabase/tests/compras_pagos.test.sql">
-- Pagos en Bs o dólares, dólar efectivo y saldo a favor (plan 3B, tarea 2).
begin;
create extension if not exists pgtap with schema extensions;
select no_plan();

insert into auth.users (id, email) values
  ('00000000-0000-0000-0000-0000000000ad', 'admin@test.bo'),
  ('00000000-0000-0000-0000-0000000000c1', 'cliente@test.bo');
update public.profiles set role = 'admin' where id = '00000000-0000-0000-0000-0000000000ad';
insert into public.categories (id, name, slug) values ('00000000-0000-0000-0000-0000000000ca', 'Test', 't-cat');
insert into public.products (id, name, slug, category_id, price_cents, stock) values
  ('00000000-0000-0000-0000-000000000011', 'H', 't-ph', '00000000-0000-0000-0000-0000000000ca', 20000, 0),
  ('00000000-0000-0000-0000-000000000012', 'J', 't-pj', '00000000-0000-0000-0000-0000000000ca', 20000, 0);
insert into public.suppliers (id, name) values
  ('00000000-0000-0000-0000-0000000005b1', 'Proveedor Uno'),
  ('00000000-0000-0000-0000-0000000005b2', 'Proveedor Dos');

create function pg_temp.as_user(u text) returns void language plpgsql as $$
begin
  perform set_config('role', 'authenticated', true);
  perform set_config('request.jwt.claims', json_build_object('sub', u, 'role', 'authenticated')::text, true);
end $$;
create function pg_temp.compra(k text, supplier text, cur text, product text, qty int, price int) returns void language plpgsql as $$
begin
  perform set_config(k, public.admin_create_purchase(gen_random_uuid(), supplier::uuid, current_date, cur, null,
    jsonb_build_array(jsonb_build_object('product_id', product, 'quantity', qty, 'unit_price_cents', price)))::text, true);
end $$;
create function pg_temp.recibir(k text, rate numeric) returns void language sql as $$
  select public.admin_receive_purchase(current_setting(k)::uuid, null, 0, rate)
$$;
create function pg_temp.pagar(k text, cur text, amount int, rate numeric, kind text default 'pago', req uuid default gen_random_uuid()) returns uuid language sql as $$
  select public.admin_record_payment(req, current_setting(k)::uuid, current_date, cur, amount, rate, null, kind)
$$;
create function pg_temp.deuda(k text) returns bigint language sql as $$ select debt_cents from public.purchase_balances where id = current_setting(k)::uuid $$;
create function pg_temp.costo(k text) returns bigint language sql as $$ select sum(line_cost_cents)::bigint from public.purchase_items where purchase_id = current_setting(k)::uuid $$;

select pg_temp.as_user('00000000-0000-0000-0000-0000000000ad');

-- Compra en dólares: adelanto en US$, llegada, saldo en Bs a otro dólar -----------------------------------------
select pg_temp.compra('t.u', '00000000-0000-0000-0000-0000000005b1', 'USD', '00000000-0000-0000-0000-000000000011', 10, 1000);
select throws_like($$select pg_temp.pagar('t.u', 'USD', 4000, null)$$, 'Anota a cuánto estaba el dólar', 'un pago en dólares pide el dólar');
select pg_temp.pagar('t.u', 'USD', 4000, 6.96);
select is((select amount_bob_cents from public.purchase_payments where purchase_id = current_setting('t.u')::uuid), 27840::bigint, 'US$ 40 a 6,96 = Bs 278,40');
select pg_temp.recibir('t.u', 7.00);
select is(pg_temp.deuda('t.u'), 6000::bigint, 'se deben US$ 60');
select is(pg_temp.costo('t.u'), 69840::bigint, 'costo: Bs 278,40 pagados + US$ 60 a 7,00');
select set_config('t.req', gen_random_uuid()::text, true);
select pg_temp.pagar('t.u', 'BOB', 42600, 7.10, 'pago', current_setting('t.req')::uuid);
select pg_temp.pagar('t.u', 'BOB', 42600, 7.10, 'pago', current_setting('t.req')::uuid);
select is((select count(*)::int from public.purchase_payments where purchase_id = current_setting('t.u')::uuid), 2, 'el mismo envío del pago se guarda una vez');
select is((select amount_purchase_cents from public.purchase_payments where request_id = current_setting('t.req')::uuid), 6000, 'Bs 426 a 7,10 pagan US$ 60');
select is(pg_temp.deuda('t.u'), 0::bigint, 'pagada del todo');
select is(pg_temp.costo('t.u'), 70440::bigint, 'el costo es exactamente lo que salió del bolsillo: 278,40 + 426');

-- Saldo a favor -----------------------------------------------------------------------------------------------------
select pg_temp.compra('t.a', '00000000-0000-0000-0000-0000000005b1', 'BOB', '00000000-0000-0000-0000-000000000012', 1, 1000);
select pg_temp.recibir('t.a', null);
select pg_temp.pagar('t.a', 'BOB', 1200, null);
select is(pg_temp.deuda('t.a'), -200::bigint, 'pagó de más: saldo a favor de Bs 2');
select pg_temp.compra('t.b', '00000000-0000-0000-0000-0000000005b1', 'BOB', '00000000-0000-0000-0000-000000000012', 1, 500);
select pg_temp.compra('t.otro', '00000000-0000-0000-0000-0000000005b2', 'BOB', '00000000-0000-0000-0000-000000000012', 1, 500);
select throws_like(format($$select public.admin_apply_credit(gen_random_uuid(), '%s', '%s', null)$$, current_setting('t.a'), current_setting('t.otro')),
  'Solo se puede usar el saldo en una compra del mismo proveedor', 'no se pasa a otro proveedor');
select lives_ok(format($$select public.admin_apply_credit(gen_random_uuid(), '%s', '%s', null)$$, current_setting('t.a'), current_setting('t.b')), 'usar el saldo en otra compra');
select is(pg_temp.deuda('t.a') || '/' || pg_temp.deuda('t.b'), '0/300', 'el origen queda en 0 y el destino debe 300');
select throws_like(format($$select public.admin_apply_credit(gen_random_uuid(), '%s', '%s', null)$$, current_setting('t.a'), current_setting('t.b')),
  'Esta compra no tiene saldo a favor', 'sin saldo no se pasa nada');
select lives_ok(format($$select public.admin_void_payment('%s')$$, (select id from public.purchase_payments where purchase_id = current_setting('t.b')::uuid and kind = 'saldo_recibido')),
  'anular el traspaso');
select is(pg_temp.deuda('t.a') || '/' || pg_temp.deuda('t.b'), '-200/500', 'se anulan los dos lados');
select pg_temp.pagar('t.a', 'BOB', 200, null, 'devolucion');
select is(pg_temp.deuda('t.a'), 0::bigint, 'el proveedor devolvió el saldo');
select is((select amount_cents from public.purchase_payments where purchase_id = current_setting('t.a')::uuid and kind = 'devolucion'), -200, 'la devolución se guarda en negativo');

-- No se anula una compra con pagos ----------------------------------------------------------------------------------
select throws_like(format($$select public.admin_void_purchase('%s')$$, current_setting('t.a')), 'Primero anula los pagos de esta compra', 'primero los pagos');

-- Lo que se debe a cada proveedor, por moneda -----------------------------------------------------------------------
select is((select sum(debt_cents)::int from public.purchase_balances where supplier_id = '00000000-0000-0000-0000-0000000005b1' and currency = 'BOB' and debt_cents > 0),
  500, 'al proveedor uno se le deben Bs 5');

-- Seguridad -------------------------------------------------------------------------------------------------------
select pg_temp.as_user('00000000-0000-0000-0000-0000000000c1');
