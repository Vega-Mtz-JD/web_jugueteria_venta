            <button
              key={o.value}
              type="button"
              aria-pressed={order === o.value}
              onClick={() => setOrder(o.value)}
              className={cn("min-h-9 rounded-full px-3 text-sm font-semibold", order === o.value ? "bg-verde text-crema" : "text-tinta-suave")}
